<ui:FluentWindow x:Class="newgdq.Views.SendTextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="州州发文设置" Width="760" Height="540"
        Icon="pack://application:,,,/Resources/myicon.ico"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource RegionBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        FontFamily="微软雅黑">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="州州发文设置" Background="{DynamicResource PanelBG}" Height="36">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Resources/myicon.ico" Width="18" Height="18"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>
    <DockPanel Grid.Row="1">

        <!-- 底部公共操作区 -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBG}" Padding="8,6" BorderBrush="{DynamicResource GridLine}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左：信息 + 模式选项 -->
                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="标题:" Width="40" VerticalAlignment="Center" Foreground="{DynamicResource LabelFG}"/>
                        <TextBlock x:Name="LblTitle" Text="-" Width="160" Foreground="{DynamicResource AccentFG}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="字数:" Width="40" VerticalAlignment="Center" Foreground="{DynamicResource LabelFG}"/>
                        <TextBlock x:Name="LblTextCount" Text="0" Width="60" Foreground="{DynamicResource ValueFG}" VerticalAlignment="Center"/>
                        <TextBlock Text="类型:" Width="40" VerticalAlignment="Center" Foreground="{DynamicResource LabelFG}"/>
                        <ComboBox x:Name="CmbStyle" Width="80" SelectionChanged="CmbStyle_Changed"
                                  ToolTip="自动按是否含中文标点判断；可手动覆盖">
                            <ComboBoxItem>自动</ComboBoxItem>
                            <ComboBoxItem>文章</ComboBoxItem>
                            <ComboBoxItem>单字</ComboBoxItem>
                        </ComboBox>
                        <TextBlock x:Name="LblStyle" Text="-" Width="60" Foreground="{DynamicResource TimeFG}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <RadioButton x:Name="RbnInOrder"  Content="顺序" GroupName="Order" IsChecked="True" Margin="0,0,12,0" Foreground="{DynamicResource ValueFG}"/>
                        <RadioButton x:Name="RbnOutOrder" Content="乱序" GroupName="Order" Margin="0,0,12,0" Foreground="{DynamicResource ValueFG}"/>
                        <CheckBox x:Name="ChkOneEnd" Content="以一句结束" Margin="0,0,12,0" Foreground="{DynamicResource ValueFG}"/>
                        <CheckBox x:Name="ChkNoRepeat" Content="乱序全段不重复" Margin="0,0,12,0" Foreground="{DynamicResource ValueFG}"/>
                        <CheckBox x:Name="ChkTickOut" Content="自动剔除空格" IsChecked="True" Foreground="{DynamicResource ValueFG}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <CheckBox x:Name="ChkAutoAdvance" Content="打完自动发下一段" Margin="0,0,12,0" Foreground="{DynamicResource ValueFG}"
                                  ToolTip="每打完一段，约 0.7 秒后自动载入下一段，连续不间断练习（发完最后一段自动停止）"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="发送字数" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource LabelFG}"/>
                        <ui:TextBox x:Name="TbxSendCount" Width="50" Text="25" Margin="0,0,8,0" PreviewTextInput="DigitOnly_PreviewTextInput"/>
                        <TextBlock Text="起始位置" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource LabelFG}"/>
                        <ui:TextBox x:Name="TbxSendStart" Width="50" Text="0" Margin="0,0,8,0" PreviewTextInput="DigitOnly_PreviewTextInput"/>
                        <TextBlock Text="始段号" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource LabelFG}"/>
                        <ui:TextBox x:Name="TbxStartSeg" Width="50" Text="1" PreviewTextInput="DigitOnly_PreviewTextInput"/>
                    </StackPanel>
                </StackPanel>

                <!-- 右：动作按钮 -->
                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Bottom">
                    <ui:Button x:Name="BtnGoSend"  Content="开启发文"   Width="120" Height="38"
                            Appearance="Success" FontSize="14" FontWeight="Bold"
                            Click="BtnGoSend_Click"/>
                    <ui:Button x:Name="BtnSendAll" Content="发全文（不分段）" Width="120" Height="26" Margin="0,4,0,0"
                            ToolTip="忽略每段字数，把整篇文章作为一段一次性发出"
                            Click="BtnSendAll_Click"/>
                    <ui:Button Content="关闭" Width="120" Height="26" Margin="0,4,0,0" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 顶部 4 Tab -->
        <TabControl x:Name="MainTab" Background="Transparent" BorderThickness="0">
            <!-- Tab 1 自带文章 -->
            <TabItem Header="自带文章">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ListBox Grid.Column="0" x:Name="LbxBuiltin" SelectionChanged="LbxBuiltin_SelectionChanged"
                             Background="{DynamicResource AltRowBG}" Foreground="{DynamicResource ValueFG}" BorderBrush="{DynamicResource GridLine}"/>
                    <Border Grid.Column="1" Margin="6,0,0,0" Background="{DynamicResource AltRowBG}" BorderBrush="{DynamicResource GridLine}" BorderThickness="1">
                        <TextBlock x:Name="TxtBuiltinPreview" Text="选择左侧文章查看预览" TextWrapping="Wrap"
                                   Padding="6" Foreground="{DynamicResource LabelFG}" VerticalAlignment="Top"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 2 自定义 -->
            <TabItem Header="自定义文章">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="标题:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ui:TextBox x:Name="TbxCustomTitle" Width="260" Text="自定义文章" TextChanged="TbxCustom_TextChanged"/>
                    </StackPanel>
                    <ui:TextBox Grid.Row="1" x:Name="TbxCustomBody" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" TextChanged="TbxCustom_TextChanged"/>
                </Grid>
            </TabItem>

            <!-- Tab 3 剪切板 -->
            <TabItem Header="来自剪切板">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                        <ui:Button Content="重新获取"   Click="BtnReGet_Click"   Margin="0,0,4,0"/>
                        <ui:Button Content="去掉空格"   Click="BtnTickBlock_Click" Margin="0,0,4,0"/>
                        <ui:Button Content="标点填充"   Click="BtnFillIt_Click"  Margin="0,0,8,0"/>
                        <TextBlock Text="标题:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ui:TextBox x:Name="TbxClipTitle" Width="200" Text="来自剪切板" TextChanged="TbxClip_TextChanged"/>
                    </StackPanel>
                    <ui:TextBox Grid.Row="1" x:Name="TbxClipBody" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" TextChanged="TbxClip_TextChanged"/>
                </Grid>
            </TabItem>

            <!-- Tab 4 配置：发文参数预设 -->
            <TabItem Header="配置与设置">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左：预设列表 -->
                    <DockPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock DockPanel.Dock="Top" Text="已保存的预设" FontWeight="Bold" Margin="0,0,0,4"/>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                            <ui:Button Content="删除"     Width="60" Margin="0,0,4,0" Click="BtnPresetDelete_Click"/>
                            <ui:Button Content="应用到当前" Width="100" Click="BtnPresetApply_Click"/>
                        </StackPanel>
                        <ListBox x:Name="LbxPresets" SelectionChanged="LbxPresets_SelectionChanged"
                                 DisplayMemberPath="Name"/>
                    </DockPanel>

                    <!-- 右：编辑 -->
                    <DockPanel Grid.Column="1">
                        <TextBlock DockPanel.Dock="Top" Text="编辑预设" FontWeight="Bold" Margin="0,0,0,4"/>

                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <ui:Button Content="保存为新预设"  Width="120" Margin="0,0,6,0" Click="BtnPresetCreate_Click"/>
                            <ui:Button Content="更新选中预设"  Width="120" Click="BtnPresetUpdate_Click"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="名称"        VerticalAlignment="Center"/>
                            <ui:TextBox   Grid.Row="0" Grid.Column="1" x:Name="TbxPresetName"      Margin="0,4"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="每段字数"    VerticalAlignment="Center"/>
                            <ui:TextBox   Grid.Row="1" Grid.Column="1" x:Name="TbxPresetCount"     Margin="0,4" PreviewTextInput="DigitOnly_PreviewTextInput"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="起始段号"    VerticalAlignment="Center"/>
                            <ui:TextBox   Grid.Row="2" Grid.Column="1" x:Name="TbxPresetStartSeg"  Margin="0,4" PreviewTextInput="DigitOnly_PreviewTextInput"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="起始位置"    VerticalAlignment="Center"/>
                            <ui:TextBox   Grid.Row="3" Grid.Column="1" x:Name="TbxPresetMark"      Margin="0,4" PreviewTextInput="DigitOnly_PreviewTextInput"/>

                            <CheckBox  Grid.Row="4" Grid.Column="1" x:Name="ChkPresetRandom"     Content="乱序"      VerticalAlignment="Center"/>
                            <CheckBox  Grid.Row="5" Grid.Column="1" x:Name="ChkPresetNoRepeat"   Content="不重复（全段抽完前不重复）" VerticalAlignment="Center"/>
                            <CheckBox  Grid.Row="6" Grid.Column="1" x:Name="ChkPresetOneEnd"     Content="一句结束（文章模式遇标点提前断段）" VerticalAlignment="Center"/>
                            <CheckBox  Grid.Row="7" Grid.Column="1" x:Name="ChkPresetTickOut"    Content="自动去空格"  VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="8" Grid.ColumnSpan="2" Foreground="#888" TextWrapping="Wrap" Margin="0,12,0,0"
                                       Text="预设保存在 settings.json 内，整个程序文件夹拷哪都跟着走。&#10;选中左侧列表后可点 应用到当前 → 当前面板（前 3 个 Tab）的参数会被本预设覆盖，然后开启发文即可。"/>
                        </Grid>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
    </Grid>
</ui:FluentWindow>
