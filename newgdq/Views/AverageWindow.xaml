<ui:FluentWindow x:Class="newgdq.Views.AverageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="平均成绩" Height="320" Width="520"
        Icon="pack://application:,,,/Resources/myicon.ico"
        FontFamily="微软雅黑" FontSize="12"
        Background="{DynamicResource RegionBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="平均成绩"/>
    <DockPanel Grid.Row="1" Margin="16" LastChildFill="True">
        <TextBlock DockPanel.Dock="Top" x:Name="TxtTitle" FontSize="14" FontWeight="Bold"
                   Foreground="{DynamicResource ValueFG}" Margin="0,0,0,12"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="复制" Width="80" Margin="6,0" Click="BtnCopy_Click"/>
            <Button Content="关闭" Width="80" Margin="6,0" Click="BtnClose_Click"/>
        </StackPanel>
        <Grid x:Name="GridStats">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="总段数"          VerticalAlignment="Center"/>
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtCount"      VerticalAlignment="Center" FontWeight="Bold"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="平均速度（字/分）" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtAvgSpeed"   VerticalAlignment="Center" FontWeight="Bold" Foreground="#FFE082"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="平均错一罚五"    VerticalAlignment="Center"/>
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtAvgSpeed2"  VerticalAlignment="Center" FontWeight="Bold" Foreground="#FFE082"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="平均击键（键/秒）" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtAvgJj"      VerticalAlignment="Center" FontWeight="Bold" Foreground="#81C784"/>
            <TextBlock Grid.Row="4" Grid.Column="0" Text="平均码长"        VerticalAlignment="Center"/>
            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtAvgMc"      VerticalAlignment="Center" FontWeight="Bold" Foreground="#81C784"/>
            <TextBlock Grid.Row="5" Grid.Column="0" Text="最高速度 / 总用时" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="TxtMisc"       VerticalAlignment="Center" Foreground="#90CAF9"/>
        </Grid>
    </DockPanel>
    </Grid>
</ui:FluentWindow>
