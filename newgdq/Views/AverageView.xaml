<UserControl x:Class="newgdq.Views.AverageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             FontFamily="微软雅黑" FontSize="12">
    <DockPanel Margin="16" LastChildFill="True">
        <TextBlock DockPanel.Dock="Top" x:Name="TxtTitle" Style="{StaticResource PageTitleStyle}"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <ui:Button Content="复制" Padding="12,4" MinWidth="80" Margin="6,0" Click="BtnCopy_Click"/>
        </StackPanel>
        <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top">
            <Grid x:Name="GridStats">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" MinHeight="32"/>
                    <RowDefinition Height="Auto" MinHeight="32"/>
                    <RowDefinition Height="Auto" MinHeight="32"/>
                    <RowDefinition Height="Auto" MinHeight="32"/>
                    <RowDefinition Height="Auto" MinHeight="32"/>
                    <RowDefinition Height="Auto" MinHeight="32"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="总段数"          VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtCount"      VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="平均速度（字/分）" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtAvgSpeed"   VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource SpeedFG}"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="平均错一罚五"    VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtAvgSpeed2"  VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource SpeedFG}"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="平均击键（键/秒）" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtAvgJj"      VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource KpmFG}"/>
                <TextBlock Grid.Row="4" Grid.Column="0" Text="平均码长"        VerticalAlignment="Center"/>
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtAvgMc"      VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource KpmFG}"/>
                <TextBlock Grid.Row="5" Grid.Column="0" Text="最高速度 / 总用时" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="TxtMisc"       VerticalAlignment="Center" Foreground="{DynamicResource TimeFG}"/>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
