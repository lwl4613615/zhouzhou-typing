<ui:FluentWindow x:Class="newgdq.Views.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="选择颜色" Width="360" SizeToContent="Height"
        Icon="pack://application:,,,/Resources/myicon.ico"
        FontFamily="微软雅黑" FontSize="12"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        Background="{DynamicResource RegionBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="选择颜色" Background="{DynamicResource PanelBG}" Height="36">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Resources/myicon.ico" Width="18" Height="18"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Margin="16">
            <!-- 大预览 + HEX -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="PvwBig" Grid.Column="0" Width="64" Height="64" CornerRadius="8"
                        BorderBrush="{DynamicResource GridLine}" BorderThickness="1"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="HEX" Foreground="{DynamicResource LabelFG}" Margin="0,0,0,4"/>
                    <ui:TextBox x:Name="TxtHex" MaxLength="7" VerticalContentAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- 色谱：SV 方块 + Hue 竖条 -->
            <Grid Height="160" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                </Grid.ColumnDefinitions>
                <!-- SV 取色面板 -->
                <Border Grid.Column="0" CornerRadius="6" ClipToBounds="True"
                        BorderBrush="{DynamicResource GridLine}" BorderThickness="1">
                    <Grid x:Name="SvPanel" MouseLeftButtonDown="SvPanel_Mouse" MouseMove="SvPanel_Mouse"
                          Background="Transparent">
                        <!-- 底色：纯 Hue 色 -->
                        <Rectangle x:Name="SvHueLayer"/>
                        <!-- 横向：白 → 透明（饱和度） -->
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#FFFFFFFF"/>
                                    <GradientStop Offset="1" Color="#00FFFFFF"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <!-- 纵向：透明 → 黑（明度） -->
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#00000000"/>
                                    <GradientStop Offset="1" Color="#FF000000"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <!-- 选取游标 -->
                        <Ellipse x:Name="SvCursor" Width="12" Height="12" Stroke="White" StrokeThickness="2"
                                 IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    </Grid>
                </Border>
                <!-- Hue 竖条 -->
                <Border Grid.Column="1" Margin="6,0,0,0" CornerRadius="6" ClipToBounds="True"
                        BorderBrush="{DynamicResource GridLine}" BorderThickness="1">
                    <Grid x:Name="HuePanel" MouseLeftButtonDown="HuePanel_Mouse" MouseMove="HuePanel_Mouse"
                          Background="Transparent">
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0.00" Color="#FF0000"/>
                                    <GradientStop Offset="0.17" Color="#FFFF00"/>
                                    <GradientStop Offset="0.33" Color="#00FF00"/>
                                    <GradientStop Offset="0.50" Color="#00FFFF"/>
                                    <GradientStop Offset="0.67" Color="#0000FF"/>
                                    <GradientStop Offset="0.83" Color="#FF00FF"/>
                                    <GradientStop Offset="1.00" Color="#FF0000"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Border x:Name="HueCursor" Height="4" BorderBrush="White" BorderThickness="0,2"
                                IsHitTestVisible="False" VerticalAlignment="Top" HorizontalAlignment="Stretch"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- RGB 滑块 -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="R" VerticalAlignment="Center" Foreground="#E53935" FontWeight="Bold"/>
                <Slider x:Name="SldR" Grid.Column="1" Minimum="0" Maximum="255" VerticalAlignment="Center"/>
                <TextBlock x:Name="LblR" Grid.Column="2" Text="0" VerticalAlignment="Center" TextAlignment="Right"/>
            </Grid>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="G" VerticalAlignment="Center" Foreground="#43A047" FontWeight="Bold"/>
                <Slider x:Name="SldG" Grid.Column="1" Minimum="0" Maximum="255" VerticalAlignment="Center"/>
                <TextBlock x:Name="LblG" Grid.Column="2" Text="0" VerticalAlignment="Center" TextAlignment="Right"/>
            </Grid>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="B" VerticalAlignment="Center" Foreground="#1E88E5" FontWeight="Bold"/>
                <Slider x:Name="SldB" Grid.Column="1" Minimum="0" Maximum="255" VerticalAlignment="Center"/>
                <TextBlock x:Name="LblB" Grid.Column="2" Text="0" VerticalAlignment="Center" TextAlignment="Right"/>
            </Grid>

            <!-- 常用色板 -->
            <TextBlock Text="常用颜色" Foreground="{DynamicResource LabelFG}" Margin="0,0,0,6"/>
            <ItemsControl x:Name="Swatches">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="24" Height="24" Margin="2" CornerRadius="4" Cursor="Hand"
                                Background="{Binding}" BorderBrush="{DynamicResource GridLine}" BorderThickness="1"
                                MouseLeftButtonUp="Swatch_Click"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 按钮 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button Content="取消" MinWidth="84" Height="34" Margin="0,0,10,0" Click="BtnCancel_Click"
                           Background="{DynamicResource CellBG}" Foreground="{DynamicResource ValueFG}"
                           BorderBrush="{DynamicResource GridLine}" BorderThickness="1" FontSize="14"/>
                <ui:Button Content="确定" MinWidth="84" Height="34" Click="BtnOk_Click"
                           Background="{DynamicResource AccentFG}" Foreground="White"
                           BorderThickness="0" FontSize="14" FontWeight="SemiBold"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
