<ui:FluentWindow x:Class="newgdq.Views.ErrorBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="错字本" Height="540" Width="880"
        Icon="pack://application:,,,/Resources/myicon.ico"
        FontFamily="微软雅黑" FontSize="12"
        Background="{DynamicResource RegionBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="错字本"/>
    <DockPanel Grid.Row="1" Margin="16" LastChildFill="True">
        <!-- 顶部：时间范围 + 标题 -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <ComboBox x:Name="CmbRange" Width="110" DockPanel.Dock="Left"
                      SelectionChanged="CmbRange_SelectionChanged">
                <ComboBoxItem Content="本次"/>
                <ComboBoxItem Content="本日"/>
                <ComboBoxItem Content="本周" IsSelected="True"/>
                <ComboBoxItem Content="本月"/>
                <ComboBoxItem Content="本年"/>
                <ComboBoxItem Content="全部"/>
            </ComboBox>
            <CheckBox x:Name="ChkHideMastered" Content="隐藏已掌握" DockPanel.Dock="Right"
                      VerticalAlignment="Center" IsChecked="True"
                      ToolTip="连续打对达阈值或手动标记掌握的字不再显示"
                      Checked="ChkHideMastered_Changed" Unchecked="ChkHideMastered_Changed"/>
            <TextBlock x:Name="TxtTitle" Margin="14,0,0,0" VerticalAlignment="Center"
                       FontWeight="Bold" Foreground="{DynamicResource ValueFG}"/>
        </DockPanel>

        <!-- 底部按钮 -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <ui:Button Content="标记已掌握" Width="84" Margin="6,0" Click="BtnMaster_Click"
                    ToolTip="选中行的字标为已掌握，从默认榜单淡出（再错会重新出现）"/>
            <ui:Button Content="删除此字" Width="84" Margin="6,0" Click="BtnDeleteChar_Click"
                    ToolTip="彻底删除选中字的全部错字记录"/>
            <ui:Button Content="复制错字" Width="84" Margin="6,0" Click="BtnCopyChars_Click"
                    ToolTip="复制当前范围内去重后的错字，可粘到发文窗当练习语料"/>
            <ui:Button Content="生成练习" Width="84" Margin="6,0" Click="BtnGenPractice_Click"
                    ToolTip="把当前范围的高频错字组成重复练习段，直接送入主窗跟打区开打"/>
            <ui:Button Content="清空本范围" Width="84" Margin="6,0" Click="BtnClear_Click"/>
            <ui:Button Content="关闭" Width="72" Margin="6,0" Click="BtnClose_Click"/>
        </StackPanel>

        <!-- 主体：左表格 + 右 TOP 错字柱状图 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="300" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <!-- 排行表 -->
            <DataGrid x:Name="Grid" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      Background="Transparent" RowBackground="Transparent"
                      SelectionChanged="Grid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="正确字" Binding="{Binding Correct}" Width="70"/>
                    <DataGridTextColumn Header="打成了" Binding="{Binding TypedShow}" Width="80"/>
                    <DataGridTextColumn Header="错次" Binding="{Binding Count}" Width="60"/>
                    <DataGridTextColumn Header="连对" Binding="{Binding StreakShow}" Width="60"/>
                    <DataGridTextColumn Header="错误率" Binding="{Binding RateShow}" Width="70"/>
                    <DataGridTextColumn Header="最近一次" Binding="{Binding LastShow}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="Transparent"/>

            <!-- 右侧：TOP 柱状图（上） + 错字溯源（下） -->
            <Border Grid.Column="2" Margin="4,0,0,0" Background="{DynamicResource AltRowBG}" CornerRadius="6">
                <DockPanel Margin="6">
                    <TextBlock DockPanel.Dock="Top" Text="错字 TOP 10" FontWeight="Bold"
                               Foreground="{DynamicResource ValueFG}" Margin="4,2,0,4"/>

                    <!-- 错字溯源：点选左侧某字，列出它来自哪些文章 -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource GridLine}"
                            BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="0,6,0,0">
                        <StackPanel>
                            <TextBlock x:Name="TxtSrcTitle" Text="错字溯源（点选左侧某字查看）"
                                       FontWeight="Bold" Foreground="{DynamicResource ValueFG}" Margin="4,0,0,4"/>
                            <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="TxtSrc" Text="—" TextWrapping="Wrap"
                                           Foreground="{DynamicResource ValueFG}" Margin="4,0"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="TxtChartEmpty" DockPanel.Dock="Bottom" Visibility="Collapsed"
                               Text="暂无错字数据" Foreground="{DynamicResource ValueFG}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20"/>
                    <sp:WpfPlot x:Name="PlotErr"/>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
    </Grid>
</ui:FluentWindow>
