<ui:FluentWindow x:Class="newgdq.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="设置" Height="500" Width="560"
        Icon="pack://application:,,,/Resources/myicon.ico"
        FontFamily="微软雅黑" FontSize="12"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="设置"/>
    <Grid Grid.Row="1" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">

            <TabItem Header="字体">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="对照区字体" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CmbCompareFamily" Margin="0,4" IsEditable="True"/>
                    <ui:NumberBox Grid.Row="0" Grid.Column="2" x:Name="NudCompareSize" Margin="6,4,0,4" Minimum="8" Maximum="96" Value="22" MaxDecimalPlaces="0"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="输入区字体" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CmbInputFamily" Margin="0,4" IsEditable="True"/>
                    <ui:NumberBox Grid.Row="1" Grid.Column="2" x:Name="NudInputSize" Margin="6,4,0,4" Minimum="8" Maximum="96" Value="18" MaxDecimalPlaces="0"/>

                    <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Foreground="{DynamicResource LabelFG}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Text="字体名可直接输入（如 宋体、微软雅黑、Consolas）；点确定后立即生效。"/>
                </Grid>
            </TabItem>

            <TabItem Header="颜色">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="42"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="正确字 前景"   VerticalAlignment="Center"/>
                    <ui:TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtColorRight"   Margin="0,4" VerticalContentAlignment="Center"/>
                    <Border  Grid.Row="0" Grid.Column="2" x:Name="PvwColorRight"   Margin="6,4,0,4" BorderBrush="#666" BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="Pvw_Click" Tag="TxtColorRight"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="正确字 背景"   VerticalAlignment="Center"/>
                    <ui:TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtColorRightBg" Margin="0,4" VerticalContentAlignment="Center"/>
                    <Border  Grid.Row="1" Grid.Column="2" x:Name="PvwColorRightBg" Margin="6,4,0,4" BorderBrush="#666" BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="Pvw_Click" Tag="TxtColorRightBg"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="错误字 前景"   VerticalAlignment="Center"/>
                    <ui:TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtColorWrong"   Margin="0,4" VerticalContentAlignment="Center"/>
                    <Border  Grid.Row="2" Grid.Column="2" x:Name="PvwColorWrong"   Margin="6,4,0,4" BorderBrush="#666" BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="Pvw_Click" Tag="TxtColorWrong"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="错误字 背景"   VerticalAlignment="Center"/>
                    <ui:TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtColorWrongBg" Margin="0,4" VerticalContentAlignment="Center"/>
                    <Border  Grid.Row="3" Grid.Column="2" x:Name="PvwColorWrongBg" Margin="6,4,0,4" BorderBrush="#666" BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="Pvw_Click" Tag="TxtColorWrongBg"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="对照区 背景"   VerticalAlignment="Center"/>
                    <ui:TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtColorCompareBg" Margin="0,4" VerticalContentAlignment="Center"/>
                    <Border  Grid.Row="4" Grid.Column="2" x:Name="PvwColorCompareBg" Margin="6,4,0,4" BorderBrush="#666" BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="Pvw_Click" Tag="TxtColorCompareBg"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="输入区 背景"   VerticalAlignment="Center"/>
                    <ui:TextBox Grid.Row="5" Grid.Column="1" x:Name="TxtColorInputBg" Margin="0,4" VerticalContentAlignment="Center"/>
                    <Border  Grid.Row="5" Grid.Column="2" x:Name="PvwColorInputBg" Margin="6,4,0,4" BorderBrush="#666" BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="Pvw_Click" Tag="TxtColorInputBg"/>

                    <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="一键预设：" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ui:Button Content="默认"   Padding="12,2" Margin="2,0" Click="BtnPreset_Click" Tag="default"/>
                        <ui:Button Content="护眼"   Padding="12,2" Margin="2,0" Click="BtnPreset_Click" Tag="eye"/>
                        <ui:Button Content="高对比" Padding="12,2" Margin="2,0" Click="BtnPreset_Click" Tag="contrast"/>
                        <ui:Button Content="暗夜"   Padding="12,2" Margin="2,0" Click="BtnPreset_Click" Tag="dark"/>
                        <TextBlock Text="（只改跟打区配色，不动整体主题）" Opacity="0.6" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="个签">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" x:Name="ChkSignEnabled"
                              Content="启用个签（显示在信息条右侧签名列）" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="个签文本" VerticalAlignment="Center"/>
                    <ui:TextBox  Grid.Row="1" Grid.Column="1" x:Name="TxtSignText" Margin="0,4" VerticalContentAlignment="Center"/>
                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Top" Margin="0,12,0,0">
                        <CheckBox x:Name="ChkMinimizeToTray"
                                  Content="最小化时藏到系统托盘（点击托盘图标恢复）"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="超过 " VerticalAlignment="Center"/>
                            <ui:NumberBox x:Name="NudAutoRepeat" Width="80" Minimum="0" Maximum="60" Value="0" MaxDecimalPlaces="0"/>
                            <TextBlock Text=" 分钟无输入则自动重打（0 = 关闭）" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="速度限制：低于 " VerticalAlignment="Center"/>
                            <ui:NumberBox x:Name="NudSpeedLimit" Width="100" Minimum="0" Maximum="500" Value="0" MaxDecimalPlaces="0"/>
                            <TextBlock Text=" 字/分时不计入历史（0 = 关闭；配合底部 限制 按钮启用）" VerticalAlignment="Center"/>
                        </StackPanel>
                        <CheckBox x:Name="ChkMergeChord" Margin="0,12,0,0" VerticalContentAlignment="Top">
                            <TextBlock TextWrapping="Wrap" MaxWidth="520"
                                       Text="并击模式（默认；按键数由输入框统计，与老版口径一致。关闭则用低层钩子统计每个物理键，适合单键输入法/排查异常）"/>
                        </CheckBox>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="存储">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="配置文件路径（便携模式：始终在 exe 同目录）" FontWeight="Bold"/>
                    <ui:TextBox  Grid.Row="1" x:Name="TxtConfigPath" IsReadOnly="True" Margin="0,4,0,0"
                              TextWrapping="NoWrap" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Row="2" Text="主题（重启生效）" FontWeight="Bold" Margin="0,16,0,4"/>
                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                        <RadioButton x:Name="RdoThemeDark"  Content="暗色 Dark"  GroupName="Theme" Margin="0,0,16,0"/>
                        <RadioButton x:Name="RdoThemeLight" Content="浅色 Light" GroupName="Theme"/>
                    </StackPanel>
                    <TextBlock Grid.Row="4" Foreground="{DynamicResource LabelFG}" TextWrapping="Wrap" Margin="0,16,0,0"
                               Text="整个程序文件夹（含 settings.json）拷哪都行：U 盘、其它电脑、新用户。换机就直接复制文件夹。&#10;主题切换后需要重启程序才能完全应用（确定后会提示）。"/>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <ui:Button Content="确定" Width="80" Margin="6,0" Appearance="Primary" Click="BtnOk_Click"/>
            <ui:Button Content="取消" Width="80" Margin="6,0" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
    </Grid>
</ui:FluentWindow>
