<ui:FluentWindow x:Class="newgdq.Views.CloudMatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="群比赛设置" Width="460" Height="520" MinWidth="400" MinHeight="440"
        Icon="pack://application:,,,/Resources/myicon.ico"
        FontFamily="微软雅黑" FontSize="12"
        Background="{DynamicResource RegionBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Background="{DynamicResource RegionBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="群比赛设置" Background="{DynamicResource PanelBG}" Height="36">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Resources/myicon.ico" Width="18" Height="18"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        <DockPanel Grid.Row="1" Margin="16">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <ui:Button Content="保存" Padding="12,4" MinWidth="80" Click="BtnSave_Click"/>
                <ui:Button Content="取消" Padding="12,4" MinWidth="80" Margin="8,0,0,0" Click="BtnClose_Click"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="云中转地址" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="主持给的云函数地址，形如 https://xxx.tencentscf.com（填一次长期有效）"
                                       TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,6"/>
                            <ui:TextBox x:Name="TbxUrl" PlaceholderText="https://xxx.tencentscf.com"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="昵称（参赛显示名）" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="排行榜上显示的名字，长期保存。它只是显示名，不是口令，可随时改。"
                                       TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,6"/>
                            <ui:TextBox x:Name="TbxNickname" PlaceholderText="如 周周" MaxLength="20"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="设备身份（本机以此身份参赛）" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="本机自动生成、代表这台电脑，无需填写、不可编辑。交卷时凭它认人。"
                                       TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,6"/>
                            <ui:TextBox x:Name="TbxDeviceId" IsReadOnly="True" FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="当前文章模式" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="daily（每日文）可反复跟打、不断刷新最好成绩；match（赛文）一场只交一次。"
                                       TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,6"/>
                            <TextBlock x:Name="TxtCurrentMode" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="每场按 F4 现场输入本场口令抓文；打完自动交卷，只对比赛文生效。比赛中只能用 F8 暂停，一场只能交一次。"
                               TextWrapping="Wrap" Opacity="0.7" Margin="4,8,4,0"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
