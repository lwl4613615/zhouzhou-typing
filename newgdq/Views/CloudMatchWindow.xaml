<ui:FluentWindow x:Class="newgdq.Views.CloudMatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="群比赛设置" Width="460" Height="520" MinWidth="400" MinHeight="440"
        Icon="pack://application:,,,/Resources/myicon.ico"
        FontFamily="微软雅黑" FontSize="12"
        Background="{DynamicResource RegionBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Background="{DynamicResource RegionBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="群比赛设置" Background="{DynamicResource PanelBG}" Height="36">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Resources/myicon.ico" Width="18" Height="18"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        <DockPanel Grid.Row="1" Margin="16">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <ui:Button Content="保存" Padding="12,4" MinWidth="80" Appearance="Primary" Click="BtnSave_Click"/>
                <ui:Button Content="取消" Padding="12,4" MinWidth="80" Margin="8,0,0,0" Click="BtnClose_Click"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="云中转地址" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="主持给的云函数地址，形如 https://xxx.tencentscf.com（填一次长期有效）"
                                       TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,6"/>
                            <ui:TextBox x:Name="TbxUrl" PlaceholderText="https://xxx.tencentscf.com"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="本场口令" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="每场比赛主持发文后，机器人在群里公布的 5 位口令；按 F4 凭它抓取比赛文。换场要更新。"
                                       TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,6"/>
                            <ui:TextBox x:Name="TbxToken" PlaceholderText="如 7K2QP" MaxLength="8"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="个人码（只本次有效，不保存）" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="在群里发『领码』，机器人私聊发你 6 位个人码。它代表你本人，关掉软件即清空、绝不存盘，每次打开需重填。"
                                       TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,6"/>
                            <ui:TextBox x:Name="TbxCode" PlaceholderText="如 A8K3M9" MaxLength="8"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <ui:ToggleSwitch x:Name="TogAutoUpload" Content="打完自动上传成绩到群比赛"/>
                            <TextBlock Text="只对 F4 抓来的比赛文生效；普通跟打不会上传。比赛中只能用 F8 暂停，一场只能交一次。"
                                       TextWrapping="Wrap" Opacity="0.7" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
