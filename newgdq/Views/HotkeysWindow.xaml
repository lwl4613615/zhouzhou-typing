<ui:FluentWindow x:Class="newgdq.Views.HotkeysWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="快捷键列表" Width="460" Height="560" MinWidth="380" MinHeight="420"
        Icon="pack://application:,,,/Resources/myicon.ico"
        FontFamily="微软雅黑" FontSize="12"
        Background="{DynamicResource RegionBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Background="{DynamicResource RegionBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="快捷键列表" Background="{DynamicResource PanelBG}" Height="36">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Resources/myicon.ico" Width="18" Height="18"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        <DockPanel Grid.Row="1" Margin="16">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <ui:Button Content="确定" Padding="12,4" MinWidth="80" Click="BtnClose_Click"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="全局热键（任何窗口都生效）" Style="{StaticResource SectionTitleStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="F2" FontWeight="Bold" Margin="0,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="打开发文窗口" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="F3" FontWeight="Bold" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="重打当前段" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="F6" FontWeight="Bold" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="发下一段" Margin="0,2"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="F8" FontWeight="Bold" Margin="0,2"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="暂停 / 继续" Margin="0,2"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="主窗激活时的快捷键" Style="{StaticResource SectionTitleStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="F9" FontWeight="Bold" Margin="0,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="复制最新一段成绩" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl+R" FontWeight="Bold" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="发下一段（同 F6）" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl+U" FontWeight="Bold" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="重打当前段（同 F3）" Margin="0,2"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Ctrl+J" FontWeight="Bold" Margin="0,2"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="乱序重抽（发下一段）" Margin="0,2"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Ctrl+F2" FontWeight="Bold" Margin="0,2"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="打开发文状态窗" Margin="0,2"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Ctrl+←" FontWeight="Bold" Margin="0,2"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="上一段（跳段，仅顺序/一句结束模式）" Margin="0,2"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Ctrl+→" FontWeight="Bold" Margin="0,2"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="下一段（跳段，仅顺序/一句结束模式）" Margin="0,2"/>
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Ctrl+T" FontWeight="Bold" Margin="0,2"/>
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="发送图片成绩" Margin="0,2"/>
                                <TextBlock Grid.Row="8" Grid.Column="0" Text="Ctrl+B" FontWeight="Bold" Margin="0,2"/>
                                <TextBlock Grid.Row="8" Grid.Column="1" Text="击键评定" Margin="0,2"/>
                                <TextBlock Grid.Row="9" Grid.Column="0" Text="Ctrl+E" FontWeight="Bold" Margin="0,2"/>
                                <TextBlock Grid.Row="9" Grid.Column="1" Text="速度分析" Margin="0,2"/>
                                <TextBlock Grid.Row="10" Grid.Column="0" Text="Ctrl+G" FontWeight="Bold" Margin="0,2"/>
                                <TextBlock Grid.Row="10" Grid.Column="1" Text="跟打报告" Margin="0,2"/>
                                <TextBlock Grid.Row="11" Grid.Column="0" Text="Ctrl+Q" FontWeight="Bold" Margin="0,2"/>
                                <TextBlock Grid.Row="11" Grid.Column="1" Text="将目前文章乱序" Margin="0,2"/>
                                <TextBlock Grid.Row="12" Grid.Column="0" Text="Ctrl+W" FontWeight="Bold" Margin="0,2"/>
                                <TextBlock Grid.Row="12" Grid.Column="1" Text="英文标点换中文" Margin="0,2"/>
                                <TextBlock Grid.Row="13" Grid.Column="0" Text="Ctrl+M" FontWeight="Bold" Margin="0,2"/>
                                <TextBlock Grid.Row="13" Grid.Column="1" Text="最小化 / 还原窗口（全局）" Margin="0,2"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="提示：输入框失焦会自动暂停；回到输入框敲任意键自动继续。"
                               Foreground="{DynamicResource LabelFG}" TextWrapping="Wrap" Margin="2,0,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
