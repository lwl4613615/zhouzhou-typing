<ui:FluentWindow x:Class="newgdq.Views.TokenPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="抓取比赛文" Width="360" Height="200" MinWidth="320" MinHeight="190"
        Icon="pack://application:,,,/Resources/myicon.ico"
        FontFamily="微软雅黑" FontSize="12"
        Background="{DynamicResource RegionBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Background="{DynamicResource RegionBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="抓取比赛文" Background="{DynamicResource PanelBG}" Height="36">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Resources/myicon.ico" Width="18" Height="18"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        <StackPanel Grid.Row="1" Margin="16">
            <TextBlock Text="输入本场口令（主持发文后机器人在群里公布的 5 位口令）"
                       TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,8"/>
            <ui:TextBox x:Name="TbxToken" PlaceholderText="如 7K2QP" MaxLength="8"
                        CharacterCasing="Upper"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <ui:Button Content="抓文" Padding="14,4" MinWidth="80" IsDefault="True" Click="BtnOk_Click"/>
                <ui:Button Content="取消" Padding="14,4" MinWidth="80" Margin="8,0,0,0" IsCancel="True" Click="BtnCancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
