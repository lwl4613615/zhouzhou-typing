<UserControl x:Class="newgdq.Views.ShuangPinPracticeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:newgdq.Views"
             mc:Ignorable="d"
             Focusable="True"
             Background="{DynamicResource PanelBG}"
             d:DesignWidth="900" d:DesignHeight="500">
    <Grid>
    <DockPanel LastChildFill="True">

        <!-- 顶部工具条 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource CellBG}"
                BorderBrush="{DynamicResource GridLine}" BorderThickness="0,0,0,1" Padding="10,6">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="键位练习"
                           Foreground="{DynamicResource AccentFG}" FontWeight="Bold" FontSize="15"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>

                <TextBlock DockPanel.Dock="Left" Text="方案" Foreground="{DynamicResource LabelFG}"
                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox DockPanel.Dock="Left" x:Name="CmbScheme" Width="100" VerticalAlignment="Center"
                          SelectionChanged="CmbScheme_SelectionChanged" Margin="0,0,16,0">
                    <ComboBoxItem Content="小鹤双拼"/>
                    <ComboBoxItem Content="自然码"/>
                    <ComboBoxItem Content="五笔字根"/>
                </ComboBox>

                <TextBlock DockPanel.Dock="Left" Text="范围" Foreground="{DynamicResource LabelFG}"
                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox DockPanel.Dock="Left" x:Name="CmbMode" Width="90" VerticalAlignment="Center"
                          SelectionChanged="CmbMode_SelectionChanged" Margin="0,0,16,0">
                    <ComboBoxItem Content="混合" IsSelected="True"/>
                    <ComboBoxItem Content="仅声母"/>
                    <ComboBoxItem Content="仅韵母"/>
                    <ComboBoxItem Content="简单字"/>
                </ComboBox>

                <CheckBox DockPanel.Dock="Left" x:Name="ChkHint" Content="显示提示键"
                          Foreground="{DynamicResource ValueFG}" VerticalAlignment="Center"
                          IsChecked="True" Margin="0,0,16,0"
                          Checked="ChkHint_Changed" Unchecked="ChkHint_Changed"/>

                <CheckBox DockPanel.Dock="Left" x:Name="ChkSound" Content="声音"
                          Foreground="{DynamicResource ValueFG}" VerticalAlignment="Center"
                          IsChecked="True" Margin="0,0,16,0"
                          Checked="ChkSound_Changed" Unchecked="ChkSound_Changed"/>

                <CheckBox DockPanel.Dock="Left" x:Name="ChkHeat" Content="热力图"
                          Foreground="{DynamicResource ValueFG}" VerticalAlignment="Center"
                          ToolTip="按各键错误率给键盘上色：越红越易错"
                          IsChecked="False" Margin="0,0,16,0"
                          Checked="ChkHeat_Changed" Unchecked="ChkHeat_Changed"/>

                <Button DockPanel.Dock="Right" Content="返回跟打" Padding="12,3"
                        Click="BtnBack_Click" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="重置统计" Padding="12,3" Margin="0,0,8,0"
                        Click="BtnReset_Click" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- 底部统计条 -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource CellBG}"
                BorderBrush="{DynamicResource GridLine}" BorderThickness="0,1,0,0" Padding="10,6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="正确 " Foreground="{DynamicResource LabelFG}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtOk" Text="0" Foreground="#4CAF50" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Text="错误 " Foreground="{DynamicResource LabelFG}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtBad" Text="0" Foreground="#E53935" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Text="正确率 " Foreground="{DynamicResource LabelFG}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtAcc" Text="100%" Foreground="{DynamicResource ValueFG}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Text="连对 " Foreground="{DynamicResource LabelFG}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtStreak" Text="0" Foreground="{DynamicResource AccentFG}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Text="速度 " Foreground="{DynamicResource LabelFG}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtKpm" Text="0" Foreground="{DynamicResource ValueFG}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,2,0"/>
                <TextBlock Text="键/分 " Foreground="{DynamicResource LabelFG}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Text="反应 " Foreground="{DynamicResource LabelFG}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtReact" Text="—" Foreground="{DynamicResource ValueFG}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,2,0"/>
                <TextBlock Text="ms " Foreground="{DynamicResource LabelFG}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Text="弱点键 " Foreground="{DynamicResource LabelFG}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtWeak" Text="—" Foreground="#E57373" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 中央：题目 + 键盘 -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 题目区 -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,18,0,8">
                <TextBlock x:Name="TxtPromptKind" Text="韵母" HorizontalAlignment="Center"
                           Foreground="{DynamicResource LabelFG}" FontSize="13"/>
                <TextBlock x:Name="TxtPrompt" Text="—" HorizontalAlignment="Center"
                           Foreground="{DynamicResource ValueFG}" FontSize="44" FontWeight="Bold"/>
                <TextBlock x:Name="TxtHint" Text=" " HorizontalAlignment="Center"
                           Foreground="{DynamicResource AccentFG}" FontSize="14" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- 虚拟键盘 + 矢量双手（可滚动，避免窗口偏矮时第一行键被裁） -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center"
                            Margin="0,4,0,12">
                    <StackPanel x:Name="KeyboardHost" HorizontalAlignment="Center"/>
                    <views:FingerHandsControl x:Name="Hands" Width="380" Height="170"
                                              Margin="0,14,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>

    <!-- 练习小结：面板内淡入卡片（覆盖整个控件，半透明遮罩 + 居中卡片） -->
    <Grid x:Name="SummaryOverlay" Visibility="Collapsed"
          Background="#B0000000" Opacity="0">
        <Border Width="360" HorizontalAlignment="Center" VerticalAlignment="Center"
                CornerRadius="12" Background="{DynamicResource PanelBG}"
                BorderBrush="{DynamicResource AccentFG}" BorderThickness="1"
                Padding="0" SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="0" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel>
                <!-- 标题条 -->
                <Border CornerRadius="12,12,0,0" Background="{DynamicResource AccentFG}" Padding="18,12">
                    <TextBlock x:Name="TxtSummaryTitle" Text="本次练习小结"
                               Foreground="White" FontSize="17" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- 主数字：速度 + 反应 -->
                <Grid Margin="18,18,18,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtSumKpm" Text="0" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentFG}" FontSize="38" FontWeight="Bold"/>
                        <TextBlock Text="键/分" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource LabelFG}" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtSumReact" Text="—" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource ValueFG}" FontSize="38" FontWeight="Bold"/>
                        <TextBlock Text="平均反应 ms" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource LabelFG}" FontSize="12"/>
                    </StackPanel>
                </Grid>

                <!-- 明细行 -->
                <StackPanel Margin="22,8,22,4">
                    <Grid Margin="0,3">
                        <TextBlock Text="用时" Foreground="{DynamicResource LabelFG}" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtSumDur" Text="00:00" Foreground="{DynamicResource ValueFG}" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,3">
                        <TextBlock Text="答对 / 答错" Foreground="{DynamicResource LabelFG}" HorizontalAlignment="Left"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="TxtSumOk" Text="0" Foreground="#4CAF50" FontWeight="Bold"/>
                            <TextBlock Text=" / " Foreground="{DynamicResource LabelFG}"/>
                            <TextBlock x:Name="TxtSumBad" Text="0" Foreground="#E53935" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,3">
                        <TextBlock Text="正确率" Foreground="{DynamicResource LabelFG}" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtSumAcc" Text="100%" Foreground="{DynamicResource ValueFG}" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,3">
                        <TextBlock Text="弱点键" Foreground="{DynamicResource LabelFG}" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtSumWeak" Text="无" Foreground="#E57373" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>

                <Button x:Name="BtnSummaryClose" Content="继续" Click="BtnSummaryClose_Click"
                        Margin="22,12,22,18" Padding="0,7" FontSize="14"
                        Background="{DynamicResource AccentFG}" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Border>
    </Grid>
    </Grid>
</UserControl>
