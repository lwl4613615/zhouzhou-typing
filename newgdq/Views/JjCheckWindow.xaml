<hc:Window x:Class="newgdq.Views.JjCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="击键评定" Height="480" Width="640"
        Icon="pack://application:,,,/Resources/myicon.ico"
        FontFamily="微软雅黑" FontSize="12"
        Background="{DynamicResource RegionBrush}"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12" LastChildFill="True">
        <TextBlock DockPanel.Dock="Top" x:Name="TxtTitle"
                   FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ValueFG}" Margin="0,0,0,8"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="复制评定" Width="90" Margin="6,0" Click="BtnCopy_Click"/>
            <Button Content="关闭"     Width="80" Margin="6,0" Click="BtnClose_Click"/>
        </StackPanel>
        <oxy:PlotView x:Name="Plot" Background="{DynamicResource AltRowBG}"/>
    </DockPanel>
</hc:Window>
