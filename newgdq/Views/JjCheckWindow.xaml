<ui:FluentWindow x:Class="newgdq.Views.JjCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="击键评定" Height="480" Width="640"
        Icon="pack://application:,,,/Resources/myicon.ico"
        FontFamily="微软雅黑" FontSize="12"
        Background="{DynamicResource RegionBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="击键评定"/>
    <DockPanel Grid.Row="1" Margin="12" LastChildFill="True">
        <TextBlock DockPanel.Dock="Top" x:Name="TxtTitle"
                   FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ValueFG}" Margin="0,0,0,8"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="复制评定" Width="90" Margin="6,0" Click="BtnCopy_Click"/>
            <Button Content="关闭"     Width="80" Margin="6,0" Click="BtnClose_Click"/>
        </StackPanel>
        <sp:WpfPlot x:Name="Plot"/>
    </DockPanel>
    </Grid>
</ui:FluentWindow>
