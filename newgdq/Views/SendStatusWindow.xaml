<ui:FluentWindow x:Class="newgdq.Views.SendStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="州州跟打器发文状态" Width="300" Height="560"
        Icon="pack://application:,,,/Resources/myicon.ico"
        FontFamily="微软雅黑" FontSize="12"
        WindowStartupLocation="Manual"
        ResizeMode="CanMinimize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        Background="{DynamicResource RegionBrush}"
        Foreground="{DynamicResource ValueFG}">
    <ui:FluentWindow.Resources>
        <SolidColorBrush x:Key="Cyan"  Color="#4FC3F7"/>
        <SolidColorBrush x:Key="Amber" Color="#FFD24C"/>

        <!-- 停止 / 继续按钮的红、绿渐变（停止后按钮变身继续，颜色随之切换）-->
        <LinearGradientBrush x:Key="StopBg" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#C0392B"/>
            <GradientStop Offset="1" Color="#7E2828"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ResumeBg" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#2FAF6A"/>
            <GradientStop Offset="1" Color="#1C7C49"/>
        </LinearGradientBrush>

        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource LabelFG}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Val" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ValueFG}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="GlowBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#FFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="10,6"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeonBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Foreground">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#4FC3F7"/>
                        <GradientStop Offset="1" Color="#7CF6C9"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="#0A0E16"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border CornerRadius="3" Background="{TemplateBinding Background}" ClipToBounds="True">
                            <Grid>
                                <Rectangle x:Name="PART_Track"/>
                                <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"
                                           Fill="{TemplateBinding Foreground}" RadiusX="3" RadiusY="3"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Background="{DynamicResource RegionBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="州州跟打器发文状态" Background="{DynamicResource PanelBG}" Height="36">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Resources/myicon.ico" Width="18" Height="18"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>
    <Grid Grid.Row="1" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="8" Padding="12,10"
                Background="{DynamicResource CellBG}" BorderBrush="#2A3346" BorderThickness="1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="◆" Foreground="{StaticResource Cyan}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="发文进度" Foreground="{DynamicResource LabelFG}" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock x:Name="TxtCurSerial" Text="-" Foreground="{StaticResource Amber}" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text=" / " Foreground="{DynamicResource LabelFG}" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtTotalSerial" Text="0" Foreground="{DynamicResource ValueFG}" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <ProgressBar x:Name="PrgSent" Style="{StaticResource NeonBar}" Margin="0,8,0,2"
                             Minimum="0" Maximum="100" Value="0"/>
                <TextBlock x:Name="TxtPct" Text="0%" Foreground="{DynamicResource LabelFG}" FontSize="10" HorizontalAlignment="Right"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" CornerRadius="8" Padding="12,8" Margin="0,8,0,0"
                Background="{DynamicResource CellBG}" BorderBrush="#2A3346" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="22"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Lbl}" Text="标题"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Val}" x:Name="TxtTitle" Foreground="{StaticResource Cyan}"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Lbl}" Text="来源"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Val}" x:Name="TxtSource"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Lbl}" Text="类型"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Val}" x:Name="TxtType"/>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="2" Columns="3" Margin="0,8,0,0">
            <Border CornerRadius="8" Padding="8" Margin="0,0,4,0"
                    Background="{DynamicResource CellBG}" BorderBrush="#2A3346" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="已发" Style="{StaticResource Lbl}"/>
                    <TextBlock x:Name="TxtMark" Text="0" Foreground="{StaticResource Cyan}" FontSize="18" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border CornerRadius="8" Padding="8" Margin="2,0,2,0"
                    Background="{DynamicResource CellBG}" BorderBrush="#2A3346" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="剩余" Style="{StaticResource Lbl}"/>
                    <TextBlock x:Name="TxtRemain" Text="0" Foreground="{StaticResource Amber}" FontSize="18" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border CornerRadius="8" Padding="8" Margin="4,0,0,0"
                    Background="{DynamicResource CellBG}" BorderBrush="#2A3346" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="总数" Style="{StaticResource Lbl}"/>
                    <TextBlock x:Name="TxtTotal" Text="0" Foreground="{DynamicResource ValueFG}" FontSize="18" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="3" CornerRadius="8" Padding="12,8" Margin="0,8,0,0"
                Background="{DynamicResource CellBG}" BorderBrush="#2A3346" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="24"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Lbl}" Text="已发段数"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Val}" x:Name="TxtSentSeg"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Lbl}" Text="发送字数"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Val}" x:Name="TxtCountPerSeg"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Lbl}" Text="模式"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Val}" x:Name="TxtMode"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Lbl}" Text="起始段"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Val}" x:Name="TxtStartSeg"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Lbl}" Text="当前段"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Val}" x:Name="TxtCurSeg" Foreground="{StaticResource Amber}" FontWeight="Bold"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource Lbl}" Text="一句结束"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Val}" x:Name="TxtOneEnd"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource Lbl}" Text="不重复"/>
                <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource Val}" x:Name="TxtNoRepeat"/>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <CheckBox x:Name="ChkAutoAdvance" Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,8"
                      Content="打完自动发下一段" Foreground="{DynamicResource ValueFG}"
                      ToolTip="勾选后每打完一段约 0.7 秒自动载入下一段（发完最后一段自动停止）"
                      Click="ChkAutoAdvance_Click"/>
            <Button x:Name="BtnStop" Grid.Row="1" Grid.Column="0" Style="{StaticResource GlowBtn}"
                    Content="■ 停止发文" Margin="0,0,4,0" Click="BtnStop_Click"
                    BorderBrush="#7E2828" Background="{StaticResource StopBg}"/>
            <Button x:Name="BtnSendNext" Grid.Row="1" Grid.Column="1" Style="{StaticResource GlowBtn}"
                    Content="▶ 发下一段 (F6)" Margin="4,0,0,0" Click="BtnSendNext_Click"
                    BorderBrush="#2A6FB8">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#3A8FE0"/>
                        <GradientStop Offset="1" Color="#1F5BAA"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
        </Grid>
    </Grid>
    </Grid>
</ui:FluentWindow>
