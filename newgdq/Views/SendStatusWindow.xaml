<hc:Window x:Class="newgdq.Views.SendStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="州州跟打器发文状态" Width="290" Height="540"
        Icon="pack://application:,,,/Resources/myicon.ico"
        FontFamily="微软雅黑" FontSize="12"
        Background="{DynamicResource RegionBrush}"
        WindowStartupLocation="Manual"
        ResizeMode="CanMinimize">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：当前序列 -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="当前序列:" Foreground="#888" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock x:Name="TxtCurSerial" Text="-" Foreground="#FFD24C" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="总序列:" Foreground="#888" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock x:Name="TxtTotalSerial" Text="0" Foreground="#FFF" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" Text="当前发文" FontWeight="Bold" Foreground="#888" Margin="0,4,0,4"/>

        <!-- 中部：状态字段（标签+值，两列） -->
        <Border Grid.Row="2" Background="#1F1F22" BorderBrush="#444" BorderThickness="1" Padding="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="26"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"  Grid.Column="0" Text="文章标题"  Foreground="#888"/>
                <TextBlock Grid.Row="0"  Grid.Column="1" x:Name="TxtTitle"     Foreground="#EEE" TextTrimming="CharacterEllipsis"/>

                <TextBlock Grid.Row="1"  Grid.Column="0" Text="文章来源"  Foreground="#888"/>
                <TextBlock Grid.Row="1"  Grid.Column="1" x:Name="TxtSource"    Foreground="#EEE"/>

                <TextBlock Grid.Row="2"  Grid.Column="0" Text="文章类型"  Foreground="#888"/>
                <TextBlock Grid.Row="2"  Grid.Column="1" x:Name="TxtType"      Foreground="#EEE"/>

                <TextBlock Grid.Row="3"  Grid.Column="0" Text="已发字数"  Foreground="#888"/>
                <TextBlock Grid.Row="3"  Grid.Column="1" x:Name="TxtMark"      Foreground="#EEE"/>

                <TextBlock Grid.Row="4"  Grid.Column="0" Text="已发段数"  Foreground="#888"/>
                <TextBlock Grid.Row="4"  Grid.Column="1" x:Name="TxtSentSeg"   Foreground="#EEE"/>

                <TextBlock Grid.Row="5"  Grid.Column="0" Text="总字数"    Foreground="#888"/>
                <TextBlock Grid.Row="5"  Grid.Column="1" x:Name="TxtTotal"     Foreground="#EEE"/>

                <TextBlock Grid.Row="6"  Grid.Column="0" Text="剩余字数"  Foreground="#888"/>
                <TextBlock Grid.Row="6"  Grid.Column="1" x:Name="TxtRemain"    Foreground="#EEE"/>

                <TextBlock Grid.Row="7"  Grid.Column="0" Text="发送字数"  Foreground="#888"/>
                <TextBlock Grid.Row="7"  Grid.Column="1" x:Name="TxtCountPerSeg" Foreground="#EEE"/>

                <TextBlock Grid.Row="8"  Grid.Column="0" Text="模式"      Foreground="#888"/>
                <TextBlock Grid.Row="8"  Grid.Column="1" x:Name="TxtMode"      Foreground="#EEE"/>

                <TextBlock Grid.Row="9"  Grid.Column="0" Text="起始段号"  Foreground="#888"/>
                <TextBlock Grid.Row="9"  Grid.Column="1" x:Name="TxtStartSeg"  Foreground="#EEE"/>

                <TextBlock Grid.Row="10" Grid.Column="0" Text="当前段号"  Foreground="#888"/>
                <TextBlock Grid.Row="10" Grid.Column="1" x:Name="TxtCurSeg"    Foreground="#FFD24C" FontWeight="Bold"/>

                <TextBlock Grid.Row="11" Grid.Column="0" Text="一句结束"  Foreground="#888"/>
                <TextBlock Grid.Row="11" Grid.Column="1" x:Name="TxtOneEnd"    Foreground="#EEE"/>

                <TextBlock Grid.Row="12" Grid.Column="0" Text="不重复"    Foreground="#888"/>
                <TextBlock Grid.Row="12" Grid.Column="1" x:Name="TxtNoRepeat"  Foreground="#EEE"/>
            </Grid>
        </Border>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,8,0,0">
            <Button x:Name="BtnStop"  Content="停止发文" Width="120" Margin="0,0,6,0"
                    Background="#7E2828" Foreground="#FFF" Click="BtnStop_Click"/>
            <Button x:Name="BtnSendNext" Content="发下一段 (F6)" Click="BtnSendNext_Click"/>
        </StackPanel>
    </Grid>
</hc:Window>
