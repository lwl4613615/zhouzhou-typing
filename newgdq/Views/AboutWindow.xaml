<ui:FluentWindow x:Class="newgdq.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="关于 州州跟打器" Width="520" Height="540" MinWidth="420" MinHeight="420"
        Icon="pack://application:,,,/Resources/myicon.ico"
        FontFamily="微软雅黑" FontSize="12"
        Background="{DynamicResource RegionBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Background="{DynamicResource RegionBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="关于 州州跟打器" Background="{DynamicResource PanelBG}" Height="36">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Resources/myicon.ico" Width="18" Height="18"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        <Grid Grid.Row="1" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Image Source="pack://application:,,,/Resources/myicon.ico" Width="48" Height="48" Margin="0,0,12,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TxtTitle" Text="州州跟打器 v0.3.0" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="现代 WPF 跟打练习器（基于 taliove/tygdq 重写）" Foreground="{DynamicResource LabelFG}"/>
            </StackPanel>
        </StackPanel>

        <!-- 项目信息 -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBG}" CornerRadius="3" Padding="10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock TextWrapping="Wrap">
                    <Run Text="项目主页：" Foreground="{DynamicResource LabelFG}"/>
                    <Hyperlink x:Name="LnkProject" Click="LnkProject_Click">
                        <Run x:Name="TxtProjectUrl" Text="https://github.com/lwl4613615/zhouzhou-typing"/>
                    </Hyperlink>
                </TextBlock>
                <TextBlock Margin="0,4,0,0"><Run Text="QQ 群：    " Foreground="{DynamicResource LabelFG}"/><Run Text="17079867"/></TextBlock>
                <TextBlock Margin="0,4,0,0"><Run Text="作者邮箱： " Foreground="{DynamicResource LabelFG}"/><Run Text="4613615@qq.com"/></TextBlock>
                <TextBlock Margin="0,4,0,0"><Run Text="协议：    " Foreground="{DynamicResource LabelFG}"/><Run Text="Apache License 2.0"/></TextBlock>
            </StackPanel>
        </Border>

        <!-- 中部：联系州州（按钮 + 折叠的二维码图） -->
        <Border Grid.Row="2" Background="{DynamicResource AltRowBG}" BorderBrush="{DynamicResource GridLine}" BorderThickness="1" CornerRadius="3" Padding="12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="联系州州" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ui:Button x:Name="BtnContact" Content="显示微信二维码" Click="BtnContact_Click" Padding="12,4" MinWidth="120"/>
                    <ui:Button Content="复制微信号 synhxb" Click="BtnCopyWeChat_Click" Padding="12,4" MinWidth="140" Margin="8,0,0,0"/>
                </StackPanel>
                <Image x:Name="ImgQr" Source="pack://application:,,,/Resources/erweima.jpg"
                       Stretch="Uniform" Visibility="Collapsed"/>
            </DockPanel>
        </Border>

        <!-- 底部 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <ui:Button Content="关闭" Padding="12,4" MinWidth="80" Click="BtnClose_Click"/>
        </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
