<hc:Window x:Class="newgdq.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="关于 州州跟打器" Width="520" Height="540"
        Icon="pack://application:,,,/Resources/myicon.ico"
        FontFamily="微软雅黑" FontSize="12"
        Background="{DynamicResource RegionBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Image Source="pack://application:,,,/Resources/myicon.ico" Width="48" Height="48" Margin="0,0,12,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TxtTitle" Text="州州跟打器 v0.3.0" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="现代 WPF 跟打练习器（基于 taliove/tygdq 重写）" Foreground="#888"/>
            </StackPanel>
        </StackPanel>

        <!-- 项目信息 -->
        <Border Grid.Row="1" Background="#2D2D30" CornerRadius="3" Padding="10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock>
                    <Run Text="项目主页：" Foreground="#888"/>
                    <Hyperlink x:Name="LnkProject" Click="LnkProject_Click">
                        <Run x:Name="TxtProjectUrl" Text="https://github.com/lwl4613615/zhouzhou-typing"/>
                    </Hyperlink>
                </TextBlock>
                <TextBlock Margin="0,4,0,0"><Run Text="QQ 群：    " Foreground="#888"/><Run Text="17079867"/></TextBlock>
                <TextBlock Margin="0,4,0,0"><Run Text="作者邮箱： " Foreground="#888"/><Run Text="4613615@qq.com"/></TextBlock>
                <TextBlock Margin="0,4,0,0"><Run Text="协议：    " Foreground="#888"/><Run Text="Apache License 2.0"/></TextBlock>
            </StackPanel>
        </Border>

        <!-- 中部：联系州州（按钮 + 折叠的二维码图） -->
        <Border Grid.Row="2" Background="#1F1F22" BorderBrush="#444" BorderThickness="1" CornerRadius="3" Padding="12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="联系州州" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="BtnContact" Content="显示微信二维码" Click="BtnContact_Click" Width="140"/>
                    <Button Content="复制微信号 synhxb" Click="BtnCopyWeChat_Click" Width="160" Margin="8,0,0,0"/>
                </StackPanel>
                <Image x:Name="ImgQr" Source="pack://application:,,,/Resources/erweima.jpg"
                       Stretch="Uniform" Visibility="Collapsed"/>
            </DockPanel>
        </Border>

        <!-- 底部 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="关闭" Width="80" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</hc:Window>
