<hc:Window x:Class="newgdq.Views.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="跟打报告" Height="600" Width="820"
        Icon="pack://application:,,,/Resources/myicon.ico"
        FontFamily="微软雅黑" FontSize="12"
        Background="{DynamicResource RegionBrush}"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12" LastChildFill="True">

        <!-- 顶部：摘要 -->
        <Border DockPanel.Dock="Top" Background="#2D2D30" Padding="10" CornerRadius="3">
            <StackPanel>
                <TextBlock x:Name="TxtTitle" FontSize="14" FontWeight="Bold" Foreground="#EEE"/>
                <UniformGrid Columns="6" Margin="0,8,0,0" x:Name="StatGrid">
                    <StackPanel><TextBlock Text="速度"    Foreground="#888"/><TextBlock x:Name="TxtSpeed"  Foreground="#FFE082" FontSize="16" FontWeight="Bold"/></StackPanel>
                    <StackPanel><TextBlock Text="罚五"    Foreground="#888"/><TextBlock x:Name="TxtSpeed2" Foreground="#FFE082" FontSize="16" FontWeight="Bold"/></StackPanel>
                    <StackPanel><TextBlock Text="击键"    Foreground="#888"/><TextBlock x:Name="TxtJj"     Foreground="#81C784" FontSize="16" FontWeight="Bold"/></StackPanel>
                    <StackPanel><TextBlock Text="码长"    Foreground="#888"/><TextBlock x:Name="TxtMc"     Foreground="#81C784" FontSize="16" FontWeight="Bold"/></StackPanel>
                    <StackPanel><TextBlock Text="用时(s)" Foreground="#888"/><TextBlock x:Name="TxtSec"    Foreground="#90CAF9" FontSize="16" FontWeight="Bold"/></StackPanel>
                    <StackPanel><TextBlock Text="键/字/错/回改" Foreground="#888"/><TextBlock x:Name="TxtCounts" Foreground="#EEE" FontSize="14"/></StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- 底部按钮 -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="复制摘要"    Width="100" Margin="6,0" Click="BtnCopy_Click"/>
            <Button Content="复制成绩图"  Width="100" Margin="6,0" Click="BtnCopyImage_Click"/>
            <Button Content="保存成绩图"  Width="100" Margin="6,0" Click="BtnSaveImage_Click"/>
            <Button Content="关闭"        Width="80"  Margin="6,0" Click="BtnClose_Click"/>
        </StackPanel>

        <!-- 中部：事件 DataGrid -->
        <DataGrid x:Name="DgvEvents" Margin="0,12,0,0"
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  RowHeight="22" FontSize="12"
                  Background="#1F1F22" Foreground="#EEE"
                  RowBackground="#1F1F22" AlternatingRowBackground="#26262A"
                  LoadingRow="DgvEvents_LoadingRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="序"      Binding="{Binding Index}"                          Width="50"/>
                <DataGridTextColumn Header="累时(s)" Binding="{Binding NowTime, StringFormat=0.00}"     Width="80"/>
                <DataGridTextColumn Header="本次(s)" Binding="{Binding TotalTime, StringFormat=0.000}"  Width="80"/>
                <DataGridTextColumn Header="起"      Binding="{Binding Start}"                          Width="50"/>
                <DataGridTextColumn Header="止"      Binding="{Binding End}"                            Width="50"/>
                <DataGridTextColumn Header="长度"    Binding="{Binding Length}"                         Width="60"/>
                <DataGridTextColumn Header="键数"    Binding="{Binding TotalTick}"                      Width="60"/>
                <DataGridTextColumn Header="累键"    Binding="{Binding Tick}"                           Width="60"/>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</hc:Window>
