<ui:FluentWindow x:Class="newgdq.Views.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="跟打报告" Height="640" Width="960"
        Icon="pack://application:,,,/Resources/myicon.ico"
        FontFamily="微软雅黑" FontSize="12"
        Background="{DynamicResource RegionBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="跟打报告" Background="{DynamicResource PanelBG}" Height="36">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Resources/myicon.ico" Width="18" Height="18"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>
    <DockPanel Grid.Row="1" Margin="12" LastChildFill="True">

        <!-- 顶部：摘要 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource CellBG}" Padding="14,12" CornerRadius="8">
            <StackPanel>
                <TextBlock x:Name="TxtTitle" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,2"/>
                <UniformGrid Columns="6" Margin="0,8,0,0" x:Name="StatGrid">
                    <StackPanel><TextBlock Text="速度"    Foreground="{DynamicResource LabelFG}"/><TextBlock x:Name="TxtSpeed"  Foreground="{DynamicResource SpeedFG}" FontSize="16" FontWeight="Bold"/></StackPanel>
                    <StackPanel><TextBlock Text="罚五"    Foreground="{DynamicResource LabelFG}"/><TextBlock x:Name="TxtSpeed2" Foreground="{DynamicResource SpeedFG}" FontSize="16" FontWeight="Bold"/></StackPanel>
                    <StackPanel><TextBlock Text="击键"    Foreground="{DynamicResource LabelFG}"/><TextBlock x:Name="TxtJj"     Foreground="{DynamicResource KpmFG}" FontSize="16" FontWeight="Bold"/></StackPanel>
                    <StackPanel><TextBlock Text="码长"    Foreground="{DynamicResource LabelFG}"/><TextBlock x:Name="TxtMc"     Foreground="{DynamicResource KpmFG}" FontSize="16" FontWeight="Bold"/></StackPanel>
                    <StackPanel><TextBlock Text="用时(s)" Foreground="{DynamicResource LabelFG}"/><TextBlock x:Name="TxtSec"    Foreground="{DynamicResource TimeFG}" FontSize="16" FontWeight="Bold"/></StackPanel>
                    <StackPanel><TextBlock Text="键/字/错/回改" Foreground="{DynamicResource LabelFG}"/><TextBlock x:Name="TxtCounts" Foreground="{DynamicResource ValueFG}" FontSize="14"/></StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- 底部按钮 -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <ui:Button Content="复制摘要"    Width="100" Margin="6,0" Click="BtnCopy_Click"/>
            <ui:Button Content="复制成绩图"  Width="100" Margin="6,0" Click="BtnCopyImage_Click"/>
            <ui:Button Content="保存成绩图"  Width="100" Margin="6,0" Click="BtnSaveImage_Click"/>
            <ui:Button Content="关闭"        Width="80"  Margin="6,0" Click="BtnClose_Click"/>
        </StackPanel>

        <!-- 中部：事件 DataGrid -->
        <DataGrid x:Name="DgvEvents" Margin="0,12,0,0"
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource GridLine}"
                  RowHeight="28" FontSize="13"
                  Background="{DynamicResource CellBG}" Foreground="{DynamicResource ValueFG}"
                  RowBackground="{DynamicResource CellBG}"
                  AlternatingRowBackground="{DynamicResource AltRowBG}"
                  VerticalContentAlignment="Center"
                  LoadingRow="DgvEvents_LoadingRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="序"      Binding="{Binding Index}"                          Width="50"/>
                <DataGridTextColumn Header="累时(s)" Binding="{Binding NowTime, StringFormat=0.00}"     Width="80"/>
                <DataGridTextColumn Header="本次(s)" Binding="{Binding TotalTime, StringFormat=0.000}"  Width="80"/>
                <DataGridTextColumn Header="起"      Binding="{Binding Start}"                          Width="50"/>
                <DataGridTextColumn Header="止"      Binding="{Binding End}"                            Width="50"/>
                <DataGridTextColumn Header="长度"    Binding="{Binding Length}"                         Width="60"/>
                <DataGridTextColumn Header="键数"    Binding="{Binding TotalTick}"                      Width="60"/>
                <DataGridTextColumn Header="累键"    Binding="{Binding Tick}"                           Width="60"/>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
    </Grid>
</ui:FluentWindow>
