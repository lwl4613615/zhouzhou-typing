<UserControl x:Class="newgdq.Views.SlowCharBookView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        FontFamily="微软雅黑" FontSize="12"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <DockPanel Margin="16" LastChildFill="True">
        <!-- 顶部：时间范围 + 标题 -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <ComboBox x:Name="CmbRange" Width="110" MinWidth="100" DockPanel.Dock="Left"
                      SelectionChanged="CmbRange_SelectionChanged">
                <ComboBoxItem Content="近7天" IsSelected="True"/>
                <ComboBoxItem Content="近30天"/>
                <ComboBoxItem Content="全部"/>
            </ComboBox>
            <CheckBox x:Name="ChkHideMastered" Content="隐藏已掌握" DockPanel.Dock="Right"
                      VerticalAlignment="Center" IsChecked="True"
                      ToolTip="手动标记掌握的字不再显示，取消勾选可查看并撤销"
                      Checked="ChkHideMastered_Changed" Unchecked="ChkHideMastered_Changed"/>
            <TextBlock x:Name="TxtTitle" Margin="14,0,0,0" VerticalAlignment="Center"
                       FontWeight="Bold" Foreground="{DynamicResource ValueFG}"/>
        </DockPanel>

        <!-- 底部按钮 -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <ui:Button Content="标记/取消掌握" Padding="10,4" MinWidth="96" Margin="6,0" Click="BtnMaster_Click"
                    ToolTip="把选中行的字标为已掌握，或取消其掌握标记（再慢会重新出现）"/>
            <ui:Button Content="生成练习" Padding="10,4" MinWidth="84" Margin="6,0" Click="BtnGenPractice_Click"
                    ToolTip="按当前范围弱项分把高分慢字组成重复练习段，直接送入主窗跟打区开打"/>
            <ui:Button Content="清空本范围" Padding="10,4" MinWidth="84" Margin="6,0" Click="BtnClear_Click"
                    ToolTip="清空当前时间范围的慢字记录，只影响慢字本（不动错字本）"/>
        </StackPanel>

        <!-- 主体：左弱项排行表 + 右慢字溯源 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="460"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="280" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <!-- 弱项排行表（按弱项分倒序，慢/回改/高键耗分列） -->
            <DataGrid x:Name="Grid" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Extended"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource GridLine}"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      RowHeight="28" FontSize="13"
                      Background="{DynamicResource CellBG}" Foreground="{DynamicResource ValueFG}"
                      RowBackground="{DynamicResource CellBG}"
                      AlternatingRowBackground="{DynamicResource AltRowBG}"
                      SelectionChanged="Grid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="字" Binding="{Binding Ch}" Width="50"/>
                    <DataGridTextColumn Header="慢次数" Binding="{Binding SlowCount}" Width="66"/>
                    <DataGridTextColumn Header="均超(秒)" Binding="{Binding AvgOverShow}" Width="74"/>
                    <DataGridTextColumn Header="回改" Binding="{Binding HgCount}" Width="56"/>
                    <DataGridTextColumn Header="高键耗" Binding="{Binding HighKeyCount}" Width="64"/>
                    <DataGridTextColumn Header="错字" Binding="{Binding ErrorCount}" Width="56"/>
                    <DataGridTextColumn Header="弱项分" Binding="{Binding WeakScoreShow}" Width="66"/>
                    <DataGridTextColumn Header="已掌握" Binding="{Binding MasteredShow}" Width="60"/>
                    <DataGridTextColumn Header="最近" Binding="{Binding LastShow}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="Transparent"/>

            <!-- 右侧：慢字溯源（点选左侧某字，列出来源标题/次数/最近时间/样例上下文/位置） -->
            <Border Grid.Column="2" Margin="4,0,0,0" Background="{DynamicResource AltRowBG}" CornerRadius="6">
                <DockPanel Margin="6">
                    <TextBlock x:Name="TxtSrcTitle" DockPanel.Dock="Top" Text="慢字溯源（点选左侧某字查看）"
                               FontWeight="Bold" Foreground="{DynamicResource ValueFG}" Margin="4,2,0,6"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TxtSrc" Text="—" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ValueFG}" Margin="4,0"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
