<Application x:Class="newgdq.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:newgdq"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 默认 Dark；启动时 App.OnStartup 会按 settings.json 中 ThemeName 替换 -->
                <ResourceDictionary Source="pack://application:,,,/newgdq;component/Themes/Dark.xaml"/>
                <!-- 共享样式（圆角卡片 / 排版层级）；切主题时不被移除 -->
                <ResourceDictionary Source="pack://application:,,,/newgdq;component/Themes/Shared.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
