<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Dark"/>
        <ui:ControlsDictionary/>
    </ResourceDictionary.MergedDictionaries>

    <!-- HandyControl 主题键的替身（WPF-UI 不提供同名键） -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E8EEF6"/>

    <!-- 暗色主题（深空蓝 + 青色辉光） -->
    <SolidColorBrush x:Key="PanelBG"   Color="#1A1F2B"/>
    <SolidColorBrush x:Key="CellBG"    Color="#232938"/>
    <SolidColorBrush x:Key="DarkBG"    Color="#0E1116"/>
    <SolidColorBrush x:Key="TickBG"    Color="#161B25"/>
    <SolidColorBrush x:Key="GridLine"  Color="#2A3346"/>
    <SolidColorBrush x:Key="LabelFG"   Color="#7E8896"/>
    <SolidColorBrush x:Key="ValueFG"   Color="#E8EEF6"/>
    <SolidColorBrush x:Key="AccentFG"  Color="#FFD24C"/>
    <SolidColorBrush x:Key="AltRowBG"  Color="#1F2535"/>
    <SolidColorBrush x:Key="FootSubFG" Color="#9CB7E3"/>

    <!-- 新增：UI 细节键（替换原硬编码，支持运行时主题切换） -->
    <SolidColorBrush x:Key="TickNumFG"       Color="#C0C8D2"/>
    <SolidColorBrush x:Key="MarkerDefaultFG" Color="#9CA3AF"/>
    <SolidColorBrush x:Key="MarkerHoverBG"   Color="#2A3346"/>
    <SolidColorBrush x:Key="SplitterBG"      Color="#2A3346"/>
    <SolidColorBrush x:Key="StatusBarBorder" Color="#3F4A59"/>
    <SolidColorBrush x:Key="CompareBG"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CompareFG"       Color="#222222"/>
    <SolidColorBrush x:Key="InputBG"         Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputFG"         Color="#222222"/>
    <SolidColorBrush x:Key="InputCaretBG"    Color="#222222"/>
    <SolidColorBrush x:Key="InputBorderBG"   Color="#4FC3F7"/>
    <SolidColorBrush x:Key="BmRankBG"        Color="#4A90E2"/>
    <SolidColorBrush x:Key="ProgFillBG"      Color="#4FC3F7"/>
    <SolidColorBrush x:Key="GlassBG"         Color="#E61E2433"/>

    <!-- 新增：数据指标语义色（速度/击键/用时/错误/成功），子窗口统一引用 -->
    <SolidColorBrush x:Key="SpeedFG"   Color="#FFD24C"/>
    <SolidColorBrush x:Key="KpmFG"     Color="#4ADE80"/>
    <SolidColorBrush x:Key="TimeFG"    Color="#90CAF9"/>
    <SolidColorBrush x:Key="ErrorFG"   Color="#F87171"/>
    <SolidColorBrush x:Key="SuccessFG" Color="#22C55E"/>

    <!-- 覆盖 HandyControl 的 RegionBrush，让主体背景变深邃 -->
    <LinearGradientBrush x:Key="RegionBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#141926"/>
        <GradientStop Offset="1" Color="#0E1116"/>
    </LinearGradientBrush>
</ResourceDictionary>
