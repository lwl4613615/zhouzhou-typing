<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Light"/>
        <ui:ControlsDictionary/>
    </ResourceDictionary.MergedDictionaries>

    <!-- HandyControl 主题键的替身（WPF-UI 不提供同名键） -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#0F172A"/>

    <!-- 浅色主题（薄雾灰 + 琥珀强调） -->
    <SolidColorBrush x:Key="PanelBG"   Color="#EEF2F8"/>
    <SolidColorBrush x:Key="CellBG"    Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DarkBG"    Color="#FAFBFE"/>
    <SolidColorBrush x:Key="TickBG"    Color="#E4E8EF"/>
    <SolidColorBrush x:Key="GridLine"  Color="#CDD5E0"/>
    <SolidColorBrush x:Key="LabelFG"   Color="#5A6472"/>
    <SolidColorBrush x:Key="ValueFG"   Color="#0F172A"/>
    <SolidColorBrush x:Key="AccentFG"  Color="#D97706"/>
    <SolidColorBrush x:Key="AltRowBG"  Color="#E6ECF4"/>
    <SolidColorBrush x:Key="FootSubFG" Color="#1E40AF"/>

    <!-- 新增：UI 细节键（替换原硬编码，支持运行时主题切换） -->
    <SolidColorBrush x:Key="TickNumFG"       Color="#5A6472"/>
    <SolidColorBrush x:Key="MarkerDefaultFG" Color="#6B7280"/>
    <SolidColorBrush x:Key="MarkerHoverBG"   Color="#DCE3EC"/>
    <SolidColorBrush x:Key="SplitterBG"      Color="#CDD5E0"/>
    <SolidColorBrush x:Key="StatusBarBorder" Color="#C2CCD8"/>
    <SolidColorBrush x:Key="CompareBG"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CompareFG"       Color="#222222"/>
    <SolidColorBrush x:Key="InputBG"         Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputFG"         Color="#222222"/>
    <SolidColorBrush x:Key="InputCaretBG"    Color="#222222"/>
    <SolidColorBrush x:Key="InputBorderBG"   Color="#0EA5E9"/>
    <SolidColorBrush x:Key="BmRankBG"        Color="#2563EB"/>
    <SolidColorBrush x:Key="ProgFillBG"      Color="#0EA5E9"/>
    <SolidColorBrush x:Key="GlassBG"         Color="#F2FFFFFF"/>

    <!-- 新增：数据指标语义色（速度/击键/用时/错误/成功），子窗口统一引用 -->
    <SolidColorBrush x:Key="SpeedFG"   Color="#D97706"/>
    <SolidColorBrush x:Key="KpmFG"     Color="#059669"/>
    <SolidColorBrush x:Key="TimeFG"    Color="#0284C7"/>
    <SolidColorBrush x:Key="ErrorFG"   Color="#DC2626"/>
    <SolidColorBrush x:Key="SuccessFG" Color="#16A34A"/>

    <!-- 覆盖 HandyControl RegionBrush，营造柔和渐变 -->
    <LinearGradientBrush x:Key="RegionBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#F5F7FB"/>
        <GradientStop Offset="1" Color="#E8ECF3"/>
    </LinearGradientBrush>
</ResourceDictionary>
