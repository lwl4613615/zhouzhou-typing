<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         共享样式字典：WPF-UI 设计语言落地（圆角卡片 / 排版层级 / 数据值）
         颜色全部走 DynamicResource，跟随 Dark/Light 主题切换自动刷新。
         本字典只加载一次，不随主题切换被移除（见 App.xaml.cs ApplyTheme）。
         ============================================================ -->

    <!-- 全局兜底：裸 TextBlock 默认前景跟随主题（修复深色下黑字看不见）。
         TextBlock.Foreground 默认黑且不继承父级，未显式设色的标签会糊在深底里。
         此隐式样式只命中"未指定 Style 的 TextBlock"，显式设了 Foreground 的会覆盖它。 -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
    </Style>

    <!-- 卡片容器：圆角 + 主题面板底色 + 内边距 -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CellBG}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- 紧凑卡片：留白更小，用于信息密度高的区域 -->
    <Style x:Key="CompactCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- 页面主标题 -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ValueFG}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <!-- 分区小标题（强调色） -->
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AccentFG}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- 标签文字（次要、灰） -->
    <Style x:Key="LabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource LabelFG}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 普通数据值 -->
    <Style x:Key="DataValueStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ValueFG}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 核心大数值（速度 / 击键等，强调色 + 放大） -->
    <Style x:Key="LargeDataValueStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AccentFG}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 紧凑 DataGrid：去竖线、横线分隔、悬停高亮 -->
    <Style x:Key="CompactDataGridStyle" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridLine}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="Background" Value="{DynamicResource PanelBG}"/>
        <Setter Property="RowBackground" Value="{DynamicResource PanelBG}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource AltRowBG}"/>
        <Setter Property="Foreground" Value="{DynamicResource ValueFG}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="RowHeight" Value="26"/>
    </Style>

</ResourceDictionary>
