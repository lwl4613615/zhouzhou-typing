<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         共享样式字典：WPF-UI 设计语言落地（圆角卡片 / 排版层级 / 数据值）
         颜色全部走 DynamicResource，跟随 Dark/Light 主题切换自动刷新。
         本字典只加载一次，不随主题切换被移除（见 App.xaml.cs ApplyTheme）。
         ============================================================ -->

    <!-- 注意：不要在此放无 x:Key 的隐式 Style（如 TargetType="TextBlock"）。
         全局隐式 TextBlock 样式会命中 WPF-UI 按钮/下拉框模板内部由 ContentPresenter
         生成的文字，改写模板本应使用的前景色，导致按钮/可编辑下拉"幽灵化"。
         裸 TextBlock 的默认前景应由每个窗口根节点的 Foreground（继承属性）提供。 -->

    <!-- 卡片容器：圆角 + 主题面板底色 + 内边距 -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CellBG}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- 紧凑卡片：留白更小，用于信息密度高的区域 -->
    <Style x:Key="CompactCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- 页面主标题 -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ValueFG}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <!-- 分区小标题（强调色） -->
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AccentFG}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- 标签文字（次要、灰） -->
    <Style x:Key="LabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource LabelFG}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 普通数据值 -->
    <Style x:Key="DataValueStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ValueFG}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 核心大数值（速度 / 击键等，强调色 + 放大） -->
    <Style x:Key="LargeDataValueStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AccentFG}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 紧凑 DataGrid：去竖线、横线分隔、悬停高亮 -->
    <Style x:Key="CompactDataGridStyle" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridLine}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="Background" Value="{DynamicResource PanelBG}"/>
        <Setter Property="RowBackground" Value="{DynamicResource PanelBG}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource AltRowBG}"/>
        <Setter Property="Foreground" Value="{DynamicResource ValueFG}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="RowHeight" Value="26"/>
    </Style>

</ResourceDictionary>
