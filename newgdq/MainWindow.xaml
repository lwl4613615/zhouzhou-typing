<hc:Window x:Class="newgdq.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:local="clr-namespace:newgdq"
        mc:Ignorable="d"
        Title="州州跟打器" Height="620" Width="940"
        FontFamily="微软雅黑" FontSize="12"
        Icon="pack://application:,,,/Resources/myicon.ico"
        Background="{DynamicResource RegionBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        NonClientAreaBackground="{StaticResource PanelBG}"
        NonClientAreaForeground="#DDD"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- 信息条标签 -->
        <Style x:Key="LblText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource LabelFG}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="LblValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ValueFG}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <!-- 段号刻度尺数字（深色主题） -->
        <Style x:Key="TickNum" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDD"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
        <!-- 标记栏纯文字按钮（激活亮黄 + 下划线 + hover变亮） -->
        <Style x:Key="MarkerText" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#BBB"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="3">
                            <TextBlock x:Name="Tx" Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="12"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3D"/>
                                <Setter TargetName="Tx" Property="Foreground" Value="#FFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tx" Property="Foreground" Value="{StaticResource AccentFG}"/>
                                <Setter TargetName="Tx" Property="TextDecorations" Value="Underline"/>
                                <Setter TargetName="Tx" Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- 托盘图标：左键点击还原；右键弹菜单 -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="pack://application:,,,/Resources/myicon.ico"
                        ToolTipText="州州跟打器"
                        TrayLeftMouseDown="TrayIcon_LeftClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="显示主窗口" Click="TrayMenu_Show_Click"/>
                    <MenuItem Header="重打"      InputGestureText="F3" Click="MenuItem_Repeat_Click"/>
                    <MenuItem Header="发下一段" InputGestureText="F6 / Ctrl+R" Click="MenuItem_SendNext_Click"/>
                    <MenuItem Header="暂停 / 继续" InputGestureText="F8" Click="MenuItem_Pause_Click"/>
                    <Separator/>
                    <MenuItem Header="退出" Click="TrayMenu_Exit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- 1. 顶部菜单栏 -->
        <Menu DockPanel.Dock="Top" Background="{StaticResource PanelBG}" x:Name="MainMenu">
            <MenuItem Header="菜单">
                <MenuItem Header="发文..."    InputGestureText="F2" Click="MenuItem_OpenSendText_Click"/>
                <MenuItem Header="载文"       InputGestureText="F4" Click="MenuItem_LoadClipboard_Click"/>
                <MenuItem Header="外观..." Click="MenuItem_OpenSettings_Click"/>
                <MenuItem Header="暂停"   InputGestureText="F8" x:Name="MnuPause" Click="MenuItem_Pause_Click"/>
                <Separator/>
                <MenuItem Header="复制成绩" InputGestureText="F9"     Click="MenuItem_CopyResult_Click"/>
                <MenuItem Header="退出"     Click="MenuItem_Exit_Click"/>
            </MenuItem>
            <MenuItem Header="功能">
                <MenuItem Header="文章处理">
                    <MenuItem Header="将目前文章乱序"     InputGestureText="Ctrl+Q" Click="MenuItem_ShuffleArticle_Click"/>
                    <MenuItem Header="英文标点换中文标点" InputGestureText="Ctrl+W" Click="MenuItem_En2CnPunct_Click"/>
                    <MenuItem Header="删除空格（包含全角）"   Click="MenuItem_StripSpace_Click"/>
                </MenuItem>
                <MenuItem Header="内部测速">
                    <MenuItem Header="10字测试"     Tag="10字测试.txt"     Click="MenuItem_LoadInternal_Click"/>
                    <Separator/>
                    <MenuItem Header="常用单字前五百" Tag="常用单字前五百.txt" Click="MenuItem_LoadInternal_Click"/>
                    <MenuItem Header="常用单字中五百" Tag="常用单字中五百.txt" Click="MenuItem_LoadInternal_Click"/>
                    <MenuItem Header="常用单字后五百" Tag="常用单字后五百.txt" Click="MenuItem_LoadInternal_Click"/>
                    <MenuItem Header="常用词组前三百" Tag="常用词组前三百.txt" Click="MenuItem_LoadInternal_Click"/>
                    <MenuItem Header="岳阳楼记"       Tag="岳阳楼记.txt"       Click="MenuItem_LoadInternal_Click"/>
                    <MenuItem Header="为人民服务节选" Tag="为人民服务节选.txt" Click="MenuItem_LoadInternal_Click"/>
                    <MenuItem Header="前1500单字"     Tag="前1500单字.txt"     Click="MenuItem_LoadInternal_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="发送图片成绩" InputGestureText="Ctrl+T" Click="MenuItem_SendImageScore_Click"/>
                <MenuItem Header="平均成绩..." Click="MenuItem_OpenAverage_Click"/>
                <MenuItem Header="击键评定..." InputGestureText="Ctrl+B" Click="MenuItem_OpenJjCheck_Click"/>
                <MenuItem Header="速度分析..." InputGestureText="Ctrl+E" Click="MenuItem_OpenSpeedAnalysis_Click"/>
                <MenuItem Header="跟打报告..." InputGestureText="Ctrl+G" Click="MenuItem_OpenReport_Click"/>
                <Separator/>
                <MenuItem Header="测试自定义 bm.txt..." Click="MenuItem_TestBmFile_Click"
                          ToolTip="选一个 bm.txt 文件，验证格式是否合法 + 显示统计信息&#10;不会替换当前词典，仅用于自检"/>
                <MenuItem Header="词组模式" x:Name="MnuSmartCi" IsCheckable="True"
                          ToolTip="开：按最长词组划下划线 + 理论码长按词算；关：无下划线，只查单字"
                          Click="MnuSmartCi_Click"/>
            </MenuItem>
            <MenuItem Header="发文">
                <MenuItem Header="发文状态" InputGestureText="Ctrl+F2" Click="MenuItem_SendStatus_Click"/>
                <MenuItem Header="发下一段" InputGestureText="F6 / Ctrl+R" Click="MenuItem_SendNext_Click"/>
                <MenuItem Header="乱序重抽" Click="MenuItem_SendShuffle_Click"/>
            </MenuItem>
            <MenuItem Header="帮助">
                <MenuItem Header="快捷键列表" Click="MenuItem_Hotkeys_Click"/>
                <Separator/>
                <MenuItem Header="访问 项目主页" Click="MenuItem_Homepage_Click"/>
                <MenuItem Header="加入 QQ 交流群" Click="MenuItem_JoinQQ_Click"/>
                <MenuItem Header="关于 州州跟打器..." Click="MenuItem_About_Click"/>
            </MenuItem>
            <MenuItem Header="复位" Click="MenuItem_Reset_Click"/>
        </Menu>

        <!-- 2. 段号刻度尺已废弃（用户反馈无用） -->

        <!-- 3. 信息条（两行紧贴：上=标签 / 下=值，每个数据独占一列） -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBG}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="22"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>   <!-- 段号 -->
                    <ColumnDefinition Width="*"/>    <!-- 标题 -->
                    <ColumnDefinition Width="80"/>   <!-- 字数 -->
                    <ColumnDefinition Width="140"/>  <!-- 状态：重打/发呆/键准 -->
                    <ColumnDefinition Width="80"/>   <!-- 速度 -->
                    <ColumnDefinition Width="80"/>   <!-- 击键 -->
                    <ColumnDefinition Width="80"/>   <!-- 码长 -->
                    <ColumnDefinition Width="110"/>   <!-- 联系州州 -->
                </Grid.ColumnDefinitions>

                <!-- 上行：标签 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="段号"   Style="{StaticResource LblText}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="标题"   Style="{StaticResource LblText}"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="字数"   Style="{StaticResource LblText}"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="状态" Style="{StaticResource LblText}"
                           ToolTip="重打次数 / 发呆秒 / 键准百分比"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="速度"   Style="{StaticResource LblText}"/>
                <TextBlock Grid.Row="0" Grid.Column="5" Text="击键"   Style="{StaticResource LblText}"/>
                <TextBlock Grid.Row="0" Grid.Column="6" Text="码长"   Style="{StaticResource LblText}"/>
                <TextBlock Grid.Row="0" Grid.Column="7" Text="联系州州"   Style="{StaticResource LblText}"
                           ToolTip="点击复制 QQ 群号"/>

                <!-- 下行：值（居中） -->
                <TextBlock Grid.Row="1" Grid.Column="0" x:Name="TxtCurSegInfo" Text="-"      Style="{StaticResource LblValue}"
                           Cursor="Hand" ToolTip="点击：跳转到指定段（仅顺序/一句结束模式）"
                           MouseLeftButtonUp="TxtCurSegInfo_Click"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtTitle"      Text="-"      Style="{StaticResource LblValue}"/>
                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="TxtWordCount"  Text="0/0字"  Style="{StaticResource LblValue}"/>
                <TextBlock Grid.Row="1" Grid.Column="3" x:Name="TxtGroup"      Text="重0 呆 0s 键准 100%"      Style="{StaticResource LblValue}" FontSize="11"/>
                <TextBlock Grid.Row="1" Grid.Column="4" x:Name="TxtSpeed"      Text="0.00"   Style="{StaticResource LblValue}"/>
                <TextBlock Grid.Row="1" Grid.Column="5" x:Name="TxtJj"         Text="0.00"   Style="{StaticResource LblValue}"/>
                <TextBlock Grid.Row="1" Grid.Column="6" x:Name="TxtMc"         Text="0.00"   Style="{StaticResource LblValue}"/>
                <TextBlock Grid.Row="1" Grid.Column="7" x:Name="TxtSign"       Text="微信 synhxb"    Style="{StaticResource LblValue}"
                           Cursor="Hand" ToolTip="点击复制微信号"
                           MouseLeftButtonUp="TxtSign_LeftClick"/>

                <!-- 列间分隔（细线） -->
                <Border Grid.RowSpan="2" Grid.Column="0" BorderBrush="{StaticResource GridLine}" BorderThickness="0,0,1,0"/>
                <Border Grid.RowSpan="2" Grid.Column="1" BorderBrush="{StaticResource GridLine}" BorderThickness="0,0,1,0"/>
                <Border Grid.RowSpan="2" Grid.Column="2" BorderBrush="{StaticResource GridLine}" BorderThickness="0,0,1,0"/>
                <Border Grid.RowSpan="2" Grid.Column="3" BorderBrush="{StaticResource GridLine}" BorderThickness="0,0,1,0"/>
                <Border Grid.RowSpan="2" Grid.Column="4" BorderBrush="{StaticResource GridLine}" BorderThickness="0,0,1,0"/>
                <Border Grid.RowSpan="2" Grid.Column="5" BorderBrush="{StaticResource GridLine}" BorderThickness="0,0,1,0"/>
                <Border Grid.RowSpan="2" Grid.Column="6" BorderBrush="{StaticResource GridLine}" BorderThickness="0,0,1,0"/>
                <!-- 上下两行之间横线 -->
                <Border Grid.Row="0" Grid.ColumnSpan="8" BorderBrush="{StaticResource GridLine}" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>
            </Grid>
        </Border>

        <!-- 5. 底部：标记栏（贴底） -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBG}" Padding="4,2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ToggleButton x:Name="TogImage" Style="{StaticResource MarkerText}" Content="图片"
                              ToolTip="完成段时自动复制成绩图到剪贴板"/>
                <ToggleButton x:Name="TogBmTips" Style="{StaticResource MarkerText}" Content="编码"
                              ToolTip="编码自动提示&#10;状态条中间格显示当前字的编码 + 重数色块"
                              Checked="TogBmTips_Toggled" Unchecked="TogBmTips_Toggled"/>
                <ToggleButton x:Name="TogChart" Style="{StaticResource MarkerText}" Content="曲线"
                              ToolTip="实时速度面积曲线（独立窗口）"
                              Checked="TogChart_Toggled" Unchecked="TogChart_Toggled"/>
                <ToggleButton x:Name="TogMap" Style="{StaticResource MarkerText}" Content="地图"
                              ToolTip="嵌入式跟打地图&#10;横轴=用时，纵轴=已打字数占比&#10;实时反映节奏波动"
                              Checked="TogMap_Toggled" Unchecked="TogMap_Toggled"/>
                <ToggleButton x:Name="TogMark" Style="{StaticResource MarkerText}" Content="标记" IsChecked="True"
                              ToolTip="自动标记词组&#10;蓝=2字 紫=3字 红=4字+&#10;实线全码 / 虚线非全码"
                              Checked="TogMark_Toggled" Unchecked="TogMark_Toggled"/>
                <ToggleButton x:Name="TogSimple" Style="{StaticResource MarkerText}" Content="极简"
                              ToolTip="成绩发送以极简模式（短文本格式，P4 发送时生效）"
                              Checked="TogSimple_Toggled" Unchecked="TogSimple_Toggled"/>
                <ToggleButton x:Name="TogLimit" Style="{StaticResource MarkerText}" Content="限制"
                              ToolTip="速度限制：低于设置窗中阈值时不计入历史&#10;阈值在 菜单 → 外观 → 个签 Tab 设置"/>
                <ToggleButton x:Name="TogReplace" Style="{StaticResource MarkerText}" Content="替换"
                              ToolTip="载入文段后自动替换英文标点为中文标点"/>
                <ToggleButton x:Name="TogDetail" Style="{StaticResource MarkerText}" Content="详细" IsChecked="True"
                              ToolTip="显示/隐藏底部历史 Grid"
                              Checked="TogDetail_Toggled" Unchecked="TogDetail_Toggled"/>
            </StackPanel>
        </Border>

        <!-- 6. 跟打地图（嵌入式，贴底标记栏上方）-->
        <Border DockPanel.Dock="Bottom" x:Name="MapPanel" Visibility="Collapsed"
                Background="#16161A" BorderBrush="#333" BorderThickness="0,1,0,0"
                Height="80">
            <Canvas x:Name="MapCanvas" ClipToBounds="True" SizeChanged="MapCanvas_SizeChanged"/>
        </Border>

        <!-- 4. 主体：对照区 + 状态条 + 输入区 + 历史 Grid -->
        <Grid Background="{StaticResource PanelBG}">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" MinHeight="120"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="3*" MinHeight="220"/>
            </Grid.RowDefinitions>

            <!-- 对照区 -->
            <RichTextBox Grid.Row="0" x:Name="RtbCompare" IsReadOnly="True"
                         Style="{x:Null}"
                         BorderThickness="0" Background="White" Foreground="#222"
                         FontSize="22" FontFamily="宋体"
                         VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled"
                         Padding="0">
                <FlowDocument PagePadding="0">
                    <Paragraph Margin="0">
                        <Run Text="州州跟打器 · 快捷键 F3 重打 · 菜单 → 功能 → 内部测速 选一篇开始跟打。点“菜单 → 暂停”可暂停计时（输入框失焦也会自动暂停）。"/>
                    </Paragraph>
                </FlowDocument>
            </RichTextBox>

            <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                          DragIncrement="4"
                          Cursor="SizeNS" Background="#3A3A3D"/>

            <!-- 下半整体：状态条(Auto) + 输入区(100固定) + 历史区(*) -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

            <!-- 状态条（对照区与输入区之间） -->
            <Border Grid.Row="0" Background="{StaticResource CellBG}"
                    BorderBrush="#666" BorderThickness="0,1,0,1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="14"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>  <!-- 时间 -->
                        <ColumnDefinition Width="80"/>   <!-- 字数 -->
                        <ColumnDefinition Width="*"/>    <!-- 编码提示 / 进度条 -->
                        <ColumnDefinition Width="60"/>   <!-- 击键 -->
                        <ColumnDefinition Width="60"/>   <!-- 回改 -->
                        <ColumnDefinition Width="60"/>   <!-- 错字 -->
                        <ColumnDefinition Width="70"/>   <!-- 左:右 -->
                        <ColumnDefinition Width="80"/>   <!-- 理论码长 -->
                        <ColumnDefinition Width="200"/>  <!-- 累计 -->
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" x:Name="TxtTime"      Text="00:00.00" Style="{StaticResource LblText}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtCount1"    Text="0/0"      Style="{StaticResource LblText}"/>
                    <!-- 中间上行：编码提示三小格 (重数色块 + 字 + 码) -->
                    <Grid Grid.Row="0" Grid.Column="2" x:Name="BmTipBox" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" x:Name="BmRankBox" Background="#4A90E2"/>
                        <TextBlock Grid.Column="1" x:Name="BmChar" Text="-" Foreground="{DynamicResource ValueFG}"
                                   FontSize="12" FontFamily="宋体"
                                   TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" x:Name="BmCode" Text="-" Foreground="#FFD24C"
                                   FontSize="12" FontFamily="Consolas"
                                   TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border Grid.Column="0" BorderBrush="{StaticResource GridLine}" BorderThickness="0,0,1,0"/>
                        <Border Grid.Column="1" BorderBrush="{StaticResource GridLine}" BorderThickness="0,0,1,0"/>
                    </Grid>
                    <!-- 中间下行：字数进度条 -->
                    <Grid Grid.Row="1" Grid.Column="2" Margin="3,1" SizeChanged="ProgHost_SizeChanged">
                        <Border Background="{DynamicResource AltRowBG}" CornerRadius="2"/>
                        <Border x:Name="ProgFill" Background="#4FC3F7" CornerRadius="2"
                                HorizontalAlignment="Left" Width="0" Opacity="0.85"/>
                        <TextBlock x:Name="TxtProgress" Text="-" Foreground="{DynamicResource ValueFG}"
                                   FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Grid.Row="0" Grid.Column="3" x:Name="TxtKeysCount" Text="0" Style="{StaticResource LblText}"/>
                    <TextBlock Grid.Row="0" Grid.Column="4" x:Name="TxtHg"  Text="0" Style="{StaticResource LblText}"/>
                    <TextBlock Grid.Row="0" Grid.Column="5" x:Name="TxtCz"  Text="0" Style="{StaticResource LblText}"/>
                    <TextBlock Grid.Row="0" Grid.Column="6" x:Name="TxtRightLast" Text="0:0" Style="{StaticResource LblText}"/>
                    <TextBlock Grid.Row="0" Grid.Column="7" x:Name="TxtTheoryMc" Text="-" Style="{StaticResource LblText}"/>
                    <TextBlock Grid.Row="0" Grid.Column="8" x:Name="TxtTotalInfo" Text="0/0/1天/0"
                               Style="{StaticResource LblText}" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="时间" Style="{StaticResource LblText}" FontSize="10"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtCount1Pct" Text="0%" Style="{StaticResource LblText}" FontSize="10"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="击键" Style="{StaticResource LblText}" FontSize="10"/>
                    <TextBlock Grid.Row="1" Grid.Column="4" Text="回改" Style="{StaticResource LblText}" FontSize="10"/>
                    <TextBlock Grid.Row="1" Grid.Column="5" Text="错字" Style="{StaticResource LblText}" FontSize="10"/>
                    <TextBlock Grid.Row="1" Grid.Column="6" Text="左:右" Style="{StaticResource LblText}" FontSize="10"/>
                    <TextBlock Grid.Row="1" Grid.Column="7" Text="理论码长" Style="{StaticResource LblText}" FontSize="10"/>
                    <TextBlock Grid.Row="1" Grid.Column="8" Text="今日/累计/天/记录" Style="{StaticResource LblText}" FontSize="10" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <Border Grid.RowSpan="2" Grid.Column="0" BorderBrush="{StaticResource GridLine}" BorderThickness="0,0,1,0"/>
                    <Border Grid.RowSpan="2" Grid.Column="1" BorderBrush="{StaticResource GridLine}" BorderThickness="0,0,1,0"/>
                    <Border Grid.RowSpan="2" Grid.Column="2" BorderBrush="{StaticResource GridLine}" BorderThickness="0,0,1,0"/>
                    <Border Grid.RowSpan="2" Grid.Column="3" BorderBrush="{StaticResource GridLine}" BorderThickness="0,0,1,0"/>
                    <Border Grid.RowSpan="2" Grid.Column="4" BorderBrush="{StaticResource GridLine}" BorderThickness="0,0,1,0"/>
                    <Border Grid.RowSpan="2" Grid.Column="5" BorderBrush="{StaticResource GridLine}" BorderThickness="0,0,1,0"/>
                    <Border Grid.RowSpan="2" Grid.Column="6" BorderBrush="{StaticResource GridLine}" BorderThickness="0,0,1,0"/>
                    <Border Grid.RowSpan="2" Grid.Column="7" BorderBrush="{StaticResource GridLine}" BorderThickness="0,0,1,0"/>
                    <Border Grid.Row="0" Grid.ColumnSpan="9" BorderBrush="{StaticResource GridLine}" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>

            <!-- 输入区（去 HC 样式以消除内置 padding） -->
            <Border Grid.Row="1" BorderBrush="#4FC3F7" BorderThickness="0,2,0,2">
                <TextBox x:Name="TbxInput"
                         Style="{x:Null}"
                         IsReadOnly="True"
                         BorderThickness="0" Background="White" Foreground="#222"
                         CaretBrush="#222"
                         FontSize="18" FontFamily="宋体"
                         AcceptsReturn="False" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Visible"
                         Padding="0"/>
            </Border>

            <!-- 历史 Grid：原版无表头，第 0 行作为表头加粗显示 -->
            <!-- 历史区 + 内嵌速度曲线（左 = 曲线，右 = 历史表） -->
            <Grid Grid.Row="2" x:Name="HistoryBox">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ChartCol" Width="0"/>
                    <ColumnDefinition x:Name="ChartSplitterCol" Width="0"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左：嵌入式速度曲线（TogChart 切换可见性） -->
                <Border Grid.Column="0" Background="{DynamicResource AltRowBG}" BorderBrush="{DynamicResource GridLine}" BorderThickness="0,0,0,0">
                    <oxy:PlotView x:Name="InlineChart" Background="Transparent"/>
                </Border>
                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                              Background="#3A3A3D" Cursor="SizeWE"/>

                <!-- 右：历史表头 + DataGrid + 汇总行 -->
                <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="22"/>
                </Grid.RowDefinitions>
                <!-- 表头带 -->
                <Grid Grid.Row="0" Background="{StaticResource CellBG}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"  Text="序"   Style="{StaticResource LblValue}"/>
                    <TextBlock Grid.Column="1"  Text="时间" Style="{StaticResource LblValue}"/>
                    <TextBlock Grid.Column="2"  Text="段"   Style="{StaticResource LblValue}"/>
                    <TextBlock Grid.Column="3"  Text="速度" Style="{StaticResource LblValue}"/>
                    <TextBlock Grid.Column="4"  Text="击键" Style="{StaticResource LblValue}"/>
                    <TextBlock Grid.Column="5"  Text="码长" Style="{StaticResource LblValue}"/>
                    <TextBlock Grid.Column="6"  Text="回改" Style="{StaticResource LblValue}"/>
                    <TextBlock Grid.Column="7"  Text="错字" Style="{StaticResource LblValue}"/>
                    <TextBlock Grid.Column="8"  Text="键数" Style="{StaticResource LblValue}"/>
                    <TextBlock Grid.Column="9"  Text="字数" Style="{StaticResource LblValue}"/>
                    <TextBlock Grid.Column="10" Text="打词" Style="{StaticResource LblValue}"/>
                    <TextBlock Grid.Column="11" Text="选重" Style="{StaticResource LblValue}"/>
                    <TextBlock Grid.Column="12" Text="拼回" Style="{StaticResource LblValue}"
                               ToolTip="拼音候选框里按退格删拼音的次数(不同于跟打区回改)"/>
                    <TextBlock Grid.Column="13" Text="左:右" Style="{StaticResource LblValue}"/>
                    <TextBlock Grid.Column="14" Text="用时" Style="{StaticResource LblValue}"/>
                </Grid>
                <DataGrid Grid.Row="1" x:Name="DgvHistory"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          IsReadOnly="True"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="{StaticResource GridLine}"
                          VerticalGridLinesBrush="{StaticResource GridLine}"
                          HeadersVisibility="None"
                          Background="{StaticResource PanelBG}"
                          RowBackground="{StaticResource PanelBG}"
                          AlternatingRowBackground="{DynamicResource AltRowBG}"
                          Foreground="{DynamicResource ValueFG}"
                          ScrollViewer.VerticalScrollBarVisibility="Visible"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.CanContentScroll="True"
                          RowHeight="24" FontSize="12" FontFamily="微软雅黑">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="40" Binding="{Binding Index}"/>
                        <DataGridTextColumn Width="80" Binding="{Binding Time}"/>
                        <DataGridTextColumn Width="40" Binding="{Binding Seg}"/>
                        <DataGridTextColumn Width="70" Binding="{Binding Speed, StringFormat=0.00}"/>
                        <DataGridTextColumn Width="70" Binding="{Binding Jj, StringFormat=0.00}"/>
                        <DataGridTextColumn Width="70" Binding="{Binding Mc, StringFormat=0.00}"/>
                        <DataGridTextColumn Width="60" Binding="{Binding Hg}"/>
                        <DataGridTextColumn Width="60" Binding="{Binding Cz}"/>
                        <DataGridTextColumn Width="60" Binding="{Binding Js}"/>
                        <DataGridTextColumn Width="60" Binding="{Binding Words}"/>
                        <DataGridTextColumn Width="60" Binding="{Binding DaCi}"/>
                        <DataGridTextColumn Width="50" Binding="{Binding Reselect}"/>
                        <DataGridTextColumn Width="50" Binding="{Binding Enter}"/>
                        <DataGridTextColumn Width="70" Binding="{Binding LeftRight}"/>
                        <DataGridTextColumn Width="*"  Binding="{Binding UseTime, StringFormat=0.00}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 汇总行：今日训练时长 / 段数 / 平均速度 / 平均击键 / 平均码长 ... 末尾累计均速 -->
                <Border Grid.Row="2" Background="{StaticResource CellBG}" BorderBrush="{StaticResource GridLine}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="TxtFootLabel" Text="今日"  Foreground="{DynamicResource AccentFG}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Column="1" x:Name="TxtFootTime"   Text="00:00:00" Foreground="{DynamicResource AccentFG}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Column="2" x:Name="TxtFootSegs"   Text="0#"     Foreground="{DynamicResource AccentFG}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Column="3" x:Name="TxtFootSpeed"  Text="0.00"   Foreground="{DynamicResource ValueFG}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Column="4" x:Name="TxtFootJj"     Text="0.00"   Foreground="{DynamicResource ValueFG}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Column="5" x:Name="TxtFootMc"     Text="0.00"   Foreground="{DynamicResource ValueFG}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Column="9" x:Name="TxtFootWords"  Text="0"      Foreground="{DynamicResource ValueFG}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Column="13" x:Name="TxtFootAllAvg" Text="累计 0.00" Foreground="{DynamicResource FootSubFG}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" ToolTip="历史所有段的平均速度"/>
                        <TextBlock Grid.Column="14" x:Name="TxtFootAllJj"  Text="0.00"  Foreground="{DynamicResource FootSubFG}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" ToolTip="历史所有段的平均击键"/>
                    </Grid>
                </Border>
                </Grid>  <!-- end right grid -->
            </Grid>
            </Grid>  <!-- end 下半整体 -->
        </Grid>
    </DockPanel>
</hc:Window>
