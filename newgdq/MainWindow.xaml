<ui:FluentWindow x:Class="newgdq.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:sp="http://oxyplot.org/wpf"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:local="clr-namespace:newgdq"
        xmlns:views="clr-namespace:newgdq.Views"
        mc:Ignorable="d"
        Title="州州跟打器" Height="700" Width="1120" MinHeight="620" MinWidth="1040"
        FontFamily="微软雅黑" FontSize="12"
        Icon="pack://application:,,,/Resources/myicon.ico"
        Background="{DynamicResource RegionBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        WindowStartupLocation="CenterScreen">
    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.20"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <Window.Resources>
        <!-- 信息条标签 -->
        <Style x:Key="LblText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource LabelFG}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0.75"/>
        </Style>
        <Style x:Key="LblValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ValueFG}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <!-- 关键数值（速度/击键/码长）：放大 + 强调色，提升视觉层次 -->
        <Style x:Key="LblValueKey" TargetType="TextBlock" BasedOn="{StaticResource LblValue}">
            <Setter Property="Foreground" Value="{DynamicResource AccentFG}"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <!-- 段号刻度尺数字 -->
        <Style x:Key="TickNum" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TickNumFG}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
        <!-- 标记栏开关：胶囊(pill)样式，激活态用强调色填充 -->
        <Style x:Key="MarkerText" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MarkerDefaultFG}"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" CornerRadius="11">
                            <TextBlock x:Name="Tx" Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MarkerHoverBG}"/>
                                <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource ValueFG}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFG}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFG}"/>
                                <Setter TargetName="Tx" Property="Foreground" Value="#1A1F2B"/>
                                <Setter TargetName="Tx" Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 左侧导航栏样式（D/E 现代化重构：顶部菜单 → 左侧导航） ===== -->
        <!-- 导航分组标题 -->
        <Style x:Key="NavSection" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource LabelFG}"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="16,14,0,4"/>
        </Style>
        <!-- 主操作 CTA 按钮：金色实心，最醒目 -->
        <Style x:Key="NavCtaBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#1A1F2B"/>
            <Setter Property="Background" Value="{DynamicResource AccentFG}"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="10" Margin="10,4,10,2"
                                Background="{TemplateBinding Background}"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 纤细现代滚动条（用于左侧导航，hover 加深） -->
        <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Width="8">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="th" CornerRadius="3" Margin="2,0"
                                                        Background="{DynamicResource GridLine}" Opacity="0.7"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="th" Property="Background" Value="{DynamicResource LabelFG}"/>
                                                        <Setter TargetName="th" Property="Opacity" Value="1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Opacity="0" Focusable="False" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Opacity="0" Focusable="False" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 导航行按钮：图标 + 文字，整行可点；hover 圆润 pill + 整行变强调色 -->
        <Style x:Key="NavRowBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ValueFG}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Margin="8,1">
                            <!-- 左侧强调指示条（hover 显现） -->
                            <Border x:Name="ind" Width="3" Height="18" CornerRadius="2"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentFG}" Opacity="0"/>
                            <Border x:Name="bd" CornerRadius="8" Padding="12,0"
                                    Background="{TemplateBinding Background}"
                                    TextElement.Foreground="{TemplateBinding Foreground}">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource MarkerHoverBG}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentFG}"/>
                                <Setter TargetName="ind" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 紧凑图标按钮（导航折叠/展开） -->
        <Style x:Key="NavIconBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource LabelFG}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource MarkerHoverBG}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentFG}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" x:Name="AppTitleBar" Title=""
                     ShowMaximize="False" ShowMinimize="False" ShowClose="False"
                     Background="{DynamicResource PanelBG}" Height="36"/>
    <DockPanel Grid.Row="1" LastChildFill="True">


        <!-- 托盘图标：左键点击还原；右键弹菜单 -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="pack://application:,,,/Resources/myicon.ico"
                        ToolTipText="州州跟打器"
                        TrayLeftMouseDown="TrayIcon_LeftClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="显示主窗口" Click="TrayMenu_Show_Click"/>
                    <MenuItem Header="重打"      InputGestureText="F3" Click="MenuItem_Repeat_Click"/>
                    <MenuItem Header="发下一段" InputGestureText="F6 / Ctrl+R" Click="MenuItem_SendNext_Click"/>
                    <Separator/>
                    <MenuItem Header="退出" Click="TrayMenu_Exit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- 1a. 折叠态展开条：窄条贴边小箭头，点击重新展开 -->
        <Border DockPanel.Dock="Left" x:Name="NavExpandStrip" Width="16" Visibility="Collapsed"
                Background="{DynamicResource PanelBG}"
                BorderBrush="{DynamicResource GridLine}" BorderThickness="0,0,1,0">
            <Button Style="{StaticResource NavIconBtn}" Width="16" Height="40"
                    VerticalAlignment="Center" Click="NavToggle_Click" ToolTip="展开导航栏">
                <ui:SymbolIcon Symbol="ChevronRight20" FontSize="13"/>
            </Button>
        </Border>

        <!-- 1. 左侧导航栏（D/E 现代化重构：顶部菜单 → 左侧导航；复用全部原 Click 处理器） -->
        <Border DockPanel.Dock="Left" x:Name="NavRail" Width="168"
                Background="{DynamicResource PanelBG}"
                BorderBrush="{DynamicResource GridLine}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <!-- 顶部品牌头 -->
                <DockPanel DockPanel.Dock="Top" Margin="14,12,6,6" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Style="{StaticResource NavIconBtn}"
                            Width="16" Height="40" VerticalAlignment="Center"
                            Click="NavToggle_Click" ToolTip="收起导航栏">
                        <ui:SymbolIcon Symbol="ChevronLeft20" FontSize="13"/>
                    </Button>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentFG}">
                        <ui:SymbolIcon Symbol="Keyboard24" FontSize="18" Foreground="#1A1F2B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="州州跟打器" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource ValueFG}"/>
                        <TextBlock Text="中文跟打练习" FontSize="10" Opacity="0.6"
                                   Foreground="{DynamicResource LabelFG}"/>
                    </StackPanel>
                </DockPanel>

                <!-- 底部固定区：外观 + 退出 -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource GridLine}"
                        BorderThickness="0,1,0,0" Padding="0,6,0,8">
                    <StackPanel>
                        <Button Style="{StaticResource NavRowBtn}" Click="MenuItem_OpenSettings_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Color24" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="外观" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavRowBtn}" Click="MenuItem_Exit_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowExit20" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="退出" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 中间滚动区：滚动条悬浮覆盖，不占布局宽度，hover 才淡入 -->
                <Grid x:Name="NavScrollHost">
                    <ScrollViewer x:Name="NavScroll" VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,2,0,8">
                    <!-- 主操作 CTA -->
                    <Button Style="{StaticResource NavCtaBtn}" Click="MenuItem_OpenSendText_Click" ToolTip="F2">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DocumentAdd24" FontSize="17" Margin="0,0,8,0"/>
                            <TextBlock Text="发文" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- 操作 -->
                    <TextBlock Text="操作" Style="{StaticResource NavSection}"/>
                    <Button Style="{StaticResource NavRowBtn}" Click="MenuItem_SendNext_Click" ToolTip="F6 / Ctrl+R">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowNext24" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="发下一段" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavRowBtn}" Click="MenuItem_SendShuffle_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowShuffle24" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="乱序重抽" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavRowBtn}" Click="MenuItem_SendStatus_Click" ToolTip="Ctrl+F2">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DataUsage24" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="发文状态" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavRowBtn}" Click="MenuItem_CopyResult_Click" ToolTip="F9">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Copy24" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="复制成绩" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavRowBtn}" Click="MenuItem_Reset_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowReset24" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="复位" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 群比赛 -->
                    <TextBlock Text="群比赛" Style="{StaticResource NavSection}"/>
                    <Button Style="{StaticResource NavRowBtn}" Click="MenuItem_OpenCloudMatch_Click"
                            ToolTip="填云地址 / 本场口令 / 个人码；F4 抓比赛文，打完自动交卷">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Trophy24" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="群比赛设置" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavRowBtn}" Click="MenuItem_FetchMatch_Click" ToolTip="F4">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="CloudArrowDown24" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="抓比赛文 (F4)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 分析 -->
                    <TextBlock Text="分析" Style="{StaticResource NavSection}"/>
                    <Button Style="{StaticResource NavRowBtn}" Click="MenuItem_OpenTrend_Click"
                            ToolTip="按天/周/月看均速趋势，和过去的自己比">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DataTrending24" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="成绩趋势" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavRowBtn}" Click="MenuItem_OpenAverage_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DataHistogram24" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="平均成绩" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavRowBtn}" Click="MenuItem_OpenJjCheck_Click" ToolTip="Ctrl+B">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Keyboard24" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="击键评定" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavRowBtn}" Click="MenuItem_OpenSpeedAnalysis_Click" ToolTip="Ctrl+E">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="TopSpeed24" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="速度分析" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavRowBtn}" Click="MenuItem_OpenReport_Click" ToolTip="Ctrl+G">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Document24" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="跟打报告" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavRowBtn}" Click="MenuItem_OpenErrorBook_Click"
                            ToolTip="按本次/本日/本周/本月/本年查看高频错字排行">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="错字本" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavRowBtn}" Click="MenuItem_SendImageScore_Click" ToolTip="Ctrl+T">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Image24" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="发送图片成绩" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 文章 / 词典 -->
                    <TextBlock Text="文章 / 词典" Style="{StaticResource NavSection}"/>
                    <Button Style="{StaticResource NavRowBtn}" Click="NavDropdown_Click">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="TextAlignLeft24" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="文章处理" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ui:SymbolIcon Symbol="ChevronDown24" FontSize="12" Opacity="0.45" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="将目前文章乱序"     InputGestureText="Ctrl+Q" Click="MenuItem_ShuffleArticle_Click"/>
                                <MenuItem Header="英文标点换中文标点" InputGestureText="Ctrl+W" Click="MenuItem_En2CnPunct_Click"/>
                                <MenuItem Header="删除空格（包含全角）"   Click="MenuItem_StripSpace_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource NavRowBtn}" Click="NavDropdown_Click">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Timer24" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="内部测速" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ui:SymbolIcon Symbol="ChevronDown24" FontSize="12" Opacity="0.45" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="10字测试"     Tag="10字测试.txt"     Click="MenuItem_LoadInternal_Click"/>
                                <Separator/>
                                <MenuItem Header="常用单字前五百" Tag="常用单字前五百.txt" Click="MenuItem_LoadInternal_Click"/>
                                <MenuItem Header="常用单字中五百" Tag="常用单字中五百.txt" Click="MenuItem_LoadInternal_Click"/>
                                <MenuItem Header="常用单字后五百" Tag="常用单字后五百.txt" Click="MenuItem_LoadInternal_Click"/>
                                <MenuItem Header="常用词组前三百" Tag="常用词组前三百.txt" Click="MenuItem_LoadInternal_Click"/>
                                <MenuItem Header="岳阳楼记"       Tag="岳阳楼记.txt"       Click="MenuItem_LoadInternal_Click"/>
                                <MenuItem Header="为人民服务节选" Tag="为人民服务节选.txt" Click="MenuItem_LoadInternal_Click"/>
                                <MenuItem Header="前1500单字"     Tag="前1500单字.txt"     Click="MenuItem_LoadInternal_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource NavRowBtn}" Click="NavDropdown_Click">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DocumentSearch24" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="词典 / 检测" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ui:SymbolIcon Symbol="ChevronDown24" FontSize="12" Opacity="0.45" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="词组模式" x:Name="MnuSmartCi" IsCheckable="True"
                                          ToolTip="开：按最长词组划下划线 + 理论码长按词算；关：无下划线，只查单字"
                                          Click="MnuSmartCi_Click"/>
                                <MenuItem Header="测试自定义 bm.txt..." Click="MenuItem_TestBmFile_Click"
                                          ToolTip="选一个 bm.txt 文件，验证格式是否合法 + 显示统计信息&#10;不会替换当前词典，仅用于自检"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- 学习 -->
                    <TextBlock Text="学习" Style="{StaticResource NavSection}"/>
                    <Button Style="{StaticResource NavRowBtn}" Click="MenuItem_OpenShuangPin_Click"
                            ToolTip="小鹤双拼 / 自然码 声母韵母键位练习（内嵌面板）">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="BookOpen24" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="键位练习" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavRowBtn}" Click="NavDropdown_Click">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Info24" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="辅助码说明" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ui:SymbolIcon Symbol="ChevronDown24" FontSize="12" Opacity="0.45" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="自然码辅助码说明..." Click="MenuItem_AuxCodeHelp_Click"
                                          ToolTip="讲清自然码「声+韵+形」辅助码怎么打（偏旁声母）"/>
                                <MenuItem Header="小鹤双拼辅助码说明..." Click="MenuItem_XhAuxCodeHelp_Click"
                                          ToolTip="打开小鹤双拼官方帮助页面"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- 设置 / 帮助 -->
                    <TextBlock Text="设置 / 帮助" Style="{StaticResource NavSection}"/>
                    <Button Style="{StaticResource NavRowBtn}" Click="NavDropdown_Click">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ZoomIn24" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="界面缩放" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ui:SymbolIcon Symbol="ChevronDown24" FontSize="12" Opacity="0.45" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="MnuUiScale">
                                <MenuItem Header="放大  (Ctrl + 滚轮上)" InputGestureText="Ctrl+加号" Click="MenuItem_ScaleUp_Click"/>
                                <MenuItem Header="缩小  (Ctrl + 滚轮下)" InputGestureText="Ctrl+减号" Click="MenuItem_ScaleDown_Click"/>
                                <Separator/>
                                <MenuItem Header="100%" Tag="1.0"  IsCheckable="True" Click="MenuItem_ScaleSet_Click"/>
                                <MenuItem Header="125%" Tag="1.25" IsCheckable="True" Click="MenuItem_ScaleSet_Click"/>
                                <MenuItem Header="150%" Tag="1.5"  IsCheckable="True" Click="MenuItem_ScaleSet_Click"/>
                                <MenuItem Header="175%" Tag="1.75" IsCheckable="True" Click="MenuItem_ScaleSet_Click"/>
                                <MenuItem Header="200%" Tag="2.0"  IsCheckable="True" Click="MenuItem_ScaleSet_Click"/>
                                <MenuItem Header="225%" Tag="2.25" IsCheckable="True" Click="MenuItem_ScaleSet_Click"/>
                                <MenuItem Header="250%" Tag="2.5"  IsCheckable="True" Click="MenuItem_ScaleSet_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource NavRowBtn}" Click="NavDropdown_Click">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="QuestionCircle24" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="帮助" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ui:SymbolIcon Symbol="ChevronDown24" FontSize="12" Opacity="0.45" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="快捷键列表" Click="MenuItem_Hotkeys_Click">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Keyboard24" FontSize="16"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="访问 项目主页" Click="MenuItem_Homepage_Click">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Home24" FontSize="16"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="加入 跟打练习群" Click="MenuItem_JoinPracticeQQ_Click">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="People24" FontSize="16"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="加入 问题反馈群" Click="MenuItem_JoinQQ_Click">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="QuestionCircle24" FontSize="16"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="关于 州州跟打器..." Click="MenuItem_About_Click">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Info24" FontSize="16"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
                    </ScrollViewer>
                    <!-- 悬浮滚动条：右贴边、不占布局、hover 才淡入 -->
                    <ScrollBar x:Name="NavScrollBar" Orientation="Vertical"
                               HorizontalAlignment="Right" Width="8" Margin="0,2,1,2"
                               Minimum="0" Maximum="{Binding ScrollableHeight, ElementName=NavScroll}"
                               ViewportSize="{Binding ViewportHeight, ElementName=NavScroll}"
                               Value="{Binding VerticalOffset, ElementName=NavScroll, Mode=OneWay}"
                               Scroll="NavScrollBar_Scroll" Opacity="0">
                        <ScrollBar.Style>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=NavRail}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="1" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="0" Duration="0:0:0.25"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollBar.Style>
                    </ScrollBar>
                </Grid>
            </DockPanel>
        </Border>

        <!-- 2. 段号刻度尺已废弃（用户反馈无用） -->

        <!-- 3. 信息条（两行紧贴：上=标签 / 下=值，每个数据独占一列） -->
        <Border DockPanel.Dock="Top" x:Name="InfoBar" Background="{DynamicResource PanelBG}"
                CornerRadius="0" Margin="0" Padding="2,0" ClipToBounds="True"
                BorderThickness="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="22"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="48"/>   <!-- 段号 -->
                    <ColumnDefinition Width="*"    MinWidth="120"/>  <!-- 标题 -->
                    <ColumnDefinition Width="Auto" MinWidth="56"/>   <!-- 字数 -->
                    <ColumnDefinition Width="Auto" MinWidth="120"/>  <!-- 状态：重打/发呆/键准 -->
                    <ColumnDefinition Width="Auto" MinWidth="56"/>   <!-- 速度 -->
                    <ColumnDefinition Width="Auto" MinWidth="56"/>   <!-- 击键 -->
                    <ColumnDefinition Width="Auto" MinWidth="56"/>   <!-- 码长 -->
                    <ColumnDefinition Width="Auto" MinWidth="80"/>   <!-- 联系州州 -->
                </Grid.ColumnDefinitions>

                <!-- 上行：标签 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="段号"   Style="{StaticResource LblText}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="标题"   Style="{StaticResource LblText}"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="字数"   Style="{StaticResource LblText}"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="状态" Style="{StaticResource LblText}"
                           ToolTip="重打次数 / 发呆秒 / 键准百分比"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="速度"   Style="{StaticResource LblText}"/>
                <TextBlock Grid.Row="0" Grid.Column="5" Text="击键"   Style="{StaticResource LblText}"/>
                <TextBlock Grid.Row="0" Grid.Column="6" Text="码长"   Style="{StaticResource LblText}"/>
                <TextBlock Grid.Row="0" Grid.Column="7" Text="联系州州"   Style="{StaticResource LblText}"
                           ToolTip="点击复制 QQ 群号"/>

                <!-- 下行：值（居中） -->
                <TextBlock Grid.Row="1" Grid.Column="0" x:Name="TxtCurSegInfo" Text="-"      Style="{StaticResource LblValue}"
                           Cursor="Hand" ToolTip="点击：跳转到指定段（仅顺序/一句结束模式）"
                           MouseLeftButtonUp="TxtCurSegInfo_Click"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtTitle"      Text="-"      Style="{StaticResource LblValue}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="TxtWordCount"  Text="0/0字"  Style="{StaticResource LblValue}"/>
                <TextBlock Grid.Row="1" Grid.Column="3" x:Name="TxtGroup"      Text="重0 呆 0s 键准 100%"      Style="{StaticResource LblValue}" FontSize="11"/>
                <TextBlock Grid.Row="1" Grid.Column="4" x:Name="TxtSpeed"      Text="0.00"   Style="{StaticResource LblValueKey}" FontSize="15"/>
                <TextBlock Grid.Row="1" Grid.Column="5" x:Name="TxtJj"         Text="0.00"   Style="{StaticResource LblValueKey}" FontSize="15"/>
                <TextBlock Grid.Row="1" Grid.Column="6" x:Name="TxtMc"         Text="0.00"   Style="{StaticResource LblValueKey}"/>
                <TextBlock Grid.Row="1" Grid.Column="7" x:Name="TxtSign"       Text="微信 synhxb"    Style="{StaticResource LblValue}"
                           Cursor="Hand" ToolTip="点击复制微信号"
                           MouseLeftButtonUp="TxtSign_LeftClick"/>

            </Grid>
        </Border>

        <!-- 5. 底部：标记栏（贴底） -->
        <Border DockPanel.Dock="Bottom" x:Name="MarkerBar" Background="{DynamicResource PanelBG}" Padding="4,2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ToggleButton x:Name="TogImage" Style="{StaticResource MarkerText}" Content="图片"
                              ToolTip="完成段时自动复制成绩图到剪贴板"/>
                <ToggleButton x:Name="TogBmTips" Style="{StaticResource MarkerText}" Content="编码"
                              ToolTip="编码自动提示&#10;状态条中间格显示当前字的编码 + 重数色块"
                              Checked="TogBmTips_Toggled" Unchecked="TogBmTips_Toggled"/>
                <ToggleButton x:Name="TogChart" Style="{StaticResource MarkerText}" Content="曲线"
                              ToolTip="实时速度面积曲线（独立窗口）"
                              Checked="TogChart_Toggled" Unchecked="TogChart_Toggled"/>
                <ToggleButton x:Name="TogMap" Style="{StaticResource MarkerText}" Content="节奏"
                              ToolTip="节奏热力条&#10;每格 = 1 个字&#10;绿色 = 快、黄/橙 = 偏慢、红色 = 卡顿&#10;最慢的字有白色发光"
                              Checked="TogMap_Toggled" Unchecked="TogMap_Toggled"/>
                <ToggleButton x:Name="TogMark" Style="{StaticResource MarkerText}" Content="标记" IsChecked="True"
                              ToolTip="自动标记词组&#10;蓝=2字 紫=3字 红=4字+&#10;实线全码 / 虚线非全码"
                              Checked="TogMark_Toggled" Unchecked="TogMark_Toggled"/>
                <ToggleButton x:Name="TogSimple" Style="{StaticResource MarkerText}" Content="极简"
                              ToolTip="成绩发送以极简模式（短文本格式，P4 发送时生效）"
                              Checked="TogSimple_Toggled" Unchecked="TogSimple_Toggled"/>
                <ToggleButton x:Name="TogLimit" Style="{StaticResource MarkerText}" Content="限制"
                              ToolTip="速度限制：低于设置窗中阈值时不计入历史&#10;阈值在 菜单 → 外观 → 个签 Tab 设置"/>
                <ToggleButton x:Name="TogReplace" Style="{StaticResource MarkerText}" Content="替换"
                              ToolTip="载入文段后自动替换英文标点为中文标点"/>
                <ToggleButton x:Name="TogDetail" Style="{StaticResource MarkerText}" Content="详细" IsChecked="True"
                              ToolTip="显示/隐藏底部历史 Grid"
                              Checked="TogDetail_Toggled" Unchecked="TogDetail_Toggled"/>
            </StackPanel>
        </Border>

        <!-- 6. 节奏热力条（贴底标记栏上方）：每格=1字，绿→红 = 该字耗时 -->
        <Border DockPanel.Dock="Bottom" x:Name="MapPanel" Visibility="Collapsed"
                Background="{DynamicResource AltRowBG}" BorderBrush="{DynamicResource GridLine}" BorderThickness="0,1,0,0"
                Height="60" ToolTip="节奏热力条：上=刻度(0-100%)，中=慢字标记(纵向堆叠避免重叠)，下=色块（绿快/红卡）">
            <Canvas x:Name="MapCanvas" ClipToBounds="True" SizeChanged="MapCanvas_SizeChanged"/>
        </Border>

        <!-- 4. 主体：对照区 + 状态条 + 输入区 + 历史 Grid（外套容器供双拼练习面板覆盖） -->
        <Grid x:Name="ContentHost">
        <Grid x:Name="MainContentRoot" Background="{DynamicResource PanelBG}">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" MinHeight="120"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="3*" MinHeight="220"/>
            </Grid.RowDefinitions>

            <!-- 对照区（卡片化：圆角纸面 + 内边距 + 四周留白，仅视觉，阅读逻辑不变） -->
            <Border Grid.Row="0" CornerRadius="6" Background="{DynamicResource CompareBG}"
                    Margin="6,4,6,2" ClipToBounds="True">
                <RichTextBox x:Name="RtbCompare" IsReadOnly="True"
                             Style="{x:Null}"
                             BorderThickness="0" Background="Transparent" Foreground="{DynamicResource CompareFG}"
                             FontSize="22" FontFamily="宋体"
                             VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled"
                             Padding="10,8">
                    <FlowDocument PagePadding="0">
                        <Paragraph Margin="0">
                            <Run Text="欢迎使用州州跟打器！打开「菜单 → 功能 → 内部测速」选一篇文章，即可开始跟打。"/>
                            <LineBreak/>
                            <Run Text="跟打时按 F3 可随时重打本篇；点「菜单 → 暂停」或让输入框失去焦点，计时会自动暂停。"/>
                        </Paragraph>
                    </FlowDocument>
                </RichTextBox>
            </Border>

            <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                          DragIncrement="4"
                          Cursor="SizeNS" Background="{DynamicResource SplitterBG}"/>

            <!-- 下半整体：信息条(Auto固定高) + 输入区(*可拖) + splitter + 历史区(*可拖) -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1*" MinHeight="60"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="2*" MinHeight="80"/>
                </Grid.RowDefinitions>

            <!-- 状态条（对照区与输入区之间） -->
            <Border Grid.Row="0" Background="{DynamicResource CellBG}"
                    CornerRadius="6" Margin="6,2,6,2" ClipToBounds="True"
                    BorderBrush="{DynamicResource StatusBarBorder}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="14"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="72"/>             <!-- 时间 -->
                        <ColumnDefinition Width="Auto" MinWidth="48"/>             <!-- 字数 -->
                        <ColumnDefinition Width="*" MinWidth="120" MaxWidth="300"/> <!-- 编码提示 / 进度条 -->
                        <ColumnDefinition Width="*" MinWidth="0"/>                 <!-- 弹性 spacer：吸收多余宽度，把右侧统计推成紧凑簇 -->
                        <ColumnDefinition Width="Auto" MinWidth="44"/>             <!-- 击键 -->
                        <ColumnDefinition Width="Auto" MinWidth="44"/>             <!-- 回改 -->
                        <ColumnDefinition Width="Auto" MinWidth="44"/>             <!-- 错字 -->
                        <ColumnDefinition Width="Auto" MinWidth="52"/>             <!-- 左:右 -->
                        <ColumnDefinition Width="Auto" MinWidth="60"/>             <!-- 理论码长 -->
                        <ColumnDefinition Width="Auto" MinWidth="120"/>            <!-- 今日/累计 -->
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" x:Name="TxtTime"      Text="00:00.00" Style="{StaticResource LblValue}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtCount1"    Text="0/0"      Style="{StaticResource LblValue}"/>
                    <!-- 中间上行：编码提示三小格 (重数色块 + 字 + 码) -->
                    <Grid Grid.Row="0" Grid.Column="2" x:Name="BmTipBox" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" x:Name="BmRankBox" Background="{DynamicResource BmRankBG}"/>
                        <TextBlock Grid.Column="1" x:Name="BmChar" Text="-" Foreground="{DynamicResource ValueFG}"
                                   FontSize="12" FontFamily="宋体"
                                   TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" x:Name="BmCode" Text="-" Foreground="{DynamicResource AccentFG}"
                                   FontSize="12" FontFamily="Consolas"
                                   TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border Grid.Column="0" BorderBrush="{DynamicResource GridLine}" BorderThickness="0,0,1,0"/>
                        <Border Grid.Column="1" BorderBrush="{DynamicResource GridLine}" BorderThickness="0,0,1,0"/>
                    </Grid>
                    <!-- 中间下行：字数进度条 -->
                    <Grid Grid.Row="1" Grid.Column="2" Margin="3,1" SizeChanged="ProgHost_SizeChanged">
                        <Border Background="{DynamicResource AltRowBG}" CornerRadius="2"/>
                        <Border x:Name="ProgFill" Background="{DynamicResource ProgFillBG}" CornerRadius="2"
                                HorizontalAlignment="Left" Width="0" Opacity="0.85"/>
                        <TextBlock x:Name="TxtProgress" Text="-" Foreground="{DynamicResource ValueFG}"
                                   FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Grid.Row="0" Grid.Column="4" x:Name="TxtKeysCount" Text="0" Style="{StaticResource LblValueKey}"/>
                    <TextBlock Grid.Row="0" Grid.Column="5" x:Name="TxtHg"  Text="0" Style="{StaticResource LblValue}"/>
                    <TextBlock Grid.Row="0" Grid.Column="6" x:Name="TxtCz"  Text="0" Style="{StaticResource LblValue}"/>
                    <TextBlock Grid.Row="0" Grid.Column="7" x:Name="TxtRightLast" Text="0:0" Style="{StaticResource LblValue}"/>
                    <TextBlock Grid.Row="0" Grid.Column="8" x:Name="TxtTheoryMc" Text="-" Style="{StaticResource LblValue}"/>
                    <TextBlock Grid.Row="0" Grid.Column="9" x:Name="TxtTotalInfo" Text="0/0/1天/0"
                               Style="{StaticResource LblValue}" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="时间" Style="{StaticResource LblText}" FontSize="10"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtCount1Pct" Text="0%" Style="{StaticResource LblText}" FontSize="10"/>
                    <TextBlock Grid.Row="1" Grid.Column="4" Text="击键" Style="{StaticResource LblText}" FontSize="10"/>
                    <TextBlock Grid.Row="1" Grid.Column="5" Text="回改" Style="{StaticResource LblText}" FontSize="10"/>
                    <TextBlock Grid.Row="1" Grid.Column="6" Text="错字" Style="{StaticResource LblText}" FontSize="10"/>
                    <TextBlock Grid.Row="1" Grid.Column="7" Text="左:右" Style="{StaticResource LblText}" FontSize="10"/>
                    <TextBlock Grid.Row="1" Grid.Column="8" Text="理论码长" Style="{StaticResource LblText}" FontSize="10"/>
                    <TextBlock Grid.Row="1" Grid.Column="9" Text="今日/累计/天/记录" Style="{StaticResource LblText}" FontSize="10" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                </Grid>
            </Border>

            <!-- 输入区（卡片化：圆角 + 强调色描边 + 内边距，仅视觉，输入逻辑不变） -->
            <Border Grid.Row="1" CornerRadius="6" Background="{DynamicResource InputBG}"
                    BorderBrush="{DynamicResource InputBorderBG}" BorderThickness="1.5"
                    Margin="6,2,6,4" ClipToBounds="True">
                <TextBox x:Name="TbxInput"
                         Style="{x:Null}"
                         IsReadOnly="True"
                         BorderThickness="0" Background="Transparent" Foreground="{DynamicResource InputFG}"
                         CaretBrush="{DynamicResource InputCaretBG}"
                         FontSize="18" FontFamily="宋体"
                         AcceptsReturn="False" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Visible"
                         Padding="10,6"/>
            </Border>

            <!-- 历史 Grid：原版无表头，第 0 行作为表头加粗显示 -->
            <!-- 历史区 + 内嵌速度曲线（左 = 曲线，右 = 历史表） -->
            <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                          DragIncrement="4"
                          Cursor="SizeNS" Background="{DynamicResource SplitterBG}"/>

            <!-- 历史 Grid：原版无表头，第 0 行作为表头加粗显示 -->
            <!-- 历史区 + 内嵌速度曲线（左 = 曲线，右 = 历史表） -->
            <Grid Grid.Row="3" x:Name="HistoryBox">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ChartCol" Width="0"/>
                    <ColumnDefinition x:Name="ChartSplitterCol" Width="0"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左：嵌入式速度曲线（TogChart 切换可见性） -->
                <Border Grid.Column="0" Background="{DynamicResource AltRowBG}" BorderBrush="{DynamicResource GridLine}" BorderThickness="0,0,0,0">
                    <sp:PlotView x:Name="InlineChart" Background="Transparent"/>
                </Border>
                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                              Background="{DynamicResource SplitterBG}" Cursor="SizeWE"/>

                <!-- 右：历史表头 + DataGrid + 汇总行 -->
                <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="22"/>
                </Grid.RowDefinitions>
                <DataGrid Grid.Row="0" x:Name="DgvHistory"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserResizeColumns="True"
                          CanUserReorderColumns="False"
                          CanUserSortColumns="False"
                          CanUserResizeRows="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource GridLine}"
                          VerticalGridLinesBrush="{DynamicResource GridLine}"
                          HeadersVisibility="Column"
                          Background="{DynamicResource PanelBG}"
                          RowBackground="{DynamicResource PanelBG}"
                          AlternatingRowBackground="{DynamicResource AltRowBG}"
                          Foreground="{DynamicResource ValueFG}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.CanContentScroll="True"
                          RowHeight="26" FontSize="12" FontFamily="微软雅黑">
                    <DataGrid.Resources>
                        <!-- 列头样式：只画底部 2px 分隔线（去竖线），更克制清爽 -->
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource CellBG}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ValueFG}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentFG}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,2"/>
                            <Setter Property="Height" Value="26"/>
                            <Setter Property="Padding" Value="4,2"/>
                        </Style>
                        <!-- 单元格内容居中：与列头对齐方式保持一致 -->
                        <Style TargetType="DataGridCell">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource MarkerHoverBG}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="序"    Width="38*" Binding="{Binding Index}"/>
                        <DataGridTextColumn Header="时间"  Width="74*" Binding="{Binding Time}"/>
                        <DataGridTextColumn Header="段"    Width="44*" Binding="{Binding Seg}"/>
                        <DataGridTextColumn Header="速度"  Width="58*" Binding="{Binding Speed, StringFormat=0.00}"/>
                        <DataGridTextColumn Header="击键"  Width="58*" Binding="{Binding Jj, StringFormat=0.00}"/>
                        <DataGridTextColumn Header="码长"  Width="58*" Binding="{Binding Mc, StringFormat=0.00}"/>
                        <DataGridTextColumn Header="回改"  Width="48*" Binding="{Binding Hg}"/>
                        <DataGridTextColumn Header="错字"  Width="48*" Binding="{Binding Cz}"/>
                        <DataGridTextColumn Header="键数"  Width="48*" Binding="{Binding Js}"/>
                        <DataGridTextColumn Header="字数"  Width="50*" Binding="{Binding Words}"/>
                        <DataGridTextColumn Header="打词"  Width="50*" Binding="{Binding DaCi}"/>
                        <DataGridTextColumn Header="选重"  Width="46*" Binding="{Binding Reselect}"/>
                        <DataGridTextColumn Header="拼回"  Width="46*" Binding="{Binding Enter}"/>
                        <DataGridTextColumn Header="左:右" Width="62*" Binding="{Binding LeftRight}"/>
                        <DataGridTextColumn Header="用时" Width="58*" Binding="{Binding UseTime, StringFormat=0.00}"/>
                        <!-- 独立的"本次/全部"切换列：用原生 DataGridColumnHeader（本身就是 ButtonBase），
                             普通字符串表头 → 与其它列头字体/颜色/对齐完全一致；HeaderStyle 挂 Click 事件 -->
                        <DataGridTemplateColumn Width="72" MinWidth="72" Header="本次">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <EventSetter Event="Loaded" Handler="ScoreFilterHeader_Loaded"/>
                                    <EventSetter Event="Click" Handler="BtnScoreFilter_Click"/>
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 汇总行：今日训练时长 / 段数 / 平均速度 / 平均击键 / 平均码长 ... 末尾累计均速
                     列宽由 SyncFooterColumns() 在代码里跟随 DataGrid 列宽实时同步 -->
                <Border Grid.Row="1" Background="{DynamicResource CellBG}" BorderBrush="{DynamicResource GridLine}" BorderThickness="0,1,0,0">
                    <Grid x:Name="FootGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38*"/>
                            <ColumnDefinition Width="74*"/>
                            <ColumnDefinition Width="44*"/>
                            <ColumnDefinition Width="58*"/>
                            <ColumnDefinition Width="58*"/>
                            <ColumnDefinition Width="58*"/>
                            <ColumnDefinition Width="48*"/>
                            <ColumnDefinition Width="48*"/>
                            <ColumnDefinition Width="48*"/>
                            <ColumnDefinition Width="50*"/>
                            <ColumnDefinition Width="50*"/>
                            <ColumnDefinition Width="46*"/>
                            <ColumnDefinition Width="46*"/>
                            <ColumnDefinition Width="62*"/>
                            <ColumnDefinition Width="58*"/>
                            <ColumnDefinition Width="52*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="TxtFootLabel" Text="今日"  Foreground="{DynamicResource AccentFG}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Cursor="Hand" ToolTip="点击查看成绩趋势（按天/周/月）" MouseLeftButtonUp="TxtFootLabel_Click"/>
                        <TextBlock Grid.Column="1" x:Name="TxtFootTime"   Text="00:00:00" Foreground="{DynamicResource AccentFG}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Column="2" x:Name="TxtFootSegs"   Text="0#"     Foreground="{DynamicResource AccentFG}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Column="3" x:Name="TxtFootSpeed"  Text="0.00"   Foreground="{DynamicResource ValueFG}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Column="4" x:Name="TxtFootJj"     Text="0.00"   Foreground="{DynamicResource ValueFG}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Column="5" x:Name="TxtFootMc"     Text="0.00"   Foreground="{DynamicResource ValueFG}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Column="9" x:Name="TxtFootWords"  Text="0"      Foreground="{DynamicResource ValueFG}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Column="13" x:Name="TxtFootAllAvg" Text="累计 0.00" Foreground="{DynamicResource FootSubFG}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" ToolTip="历史所有段的平均速度"/>
                        <TextBlock Grid.Column="14" x:Name="TxtFootAllJj"  Text="0.00"  Foreground="{DynamicResource FootSubFG}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" ToolTip="历史所有段的平均击键"/>
                    </Grid>
                </Border>
                </Grid>  <!-- end right grid -->
            </Grid>
            </Grid>  <!-- end 下半整体 -->
        </Grid>

            <!-- 双拼键位练习面板（默认隐藏，菜单 功能 → 双拼键位练习 切换） -->
            <views:ShuangPinPracticeControl x:Name="PracticePanel" Visibility="Collapsed"/>

            <!-- 分析页内嵌承载层（E：分析窗口收编为内嵌页，覆盖主跟打区） -->
            <Border x:Name="AnalysisHost" Visibility="Collapsed" Background="{DynamicResource PanelBG}">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top" Background="{DynamicResource CellBG}"
                            BorderBrush="{DynamicResource GridLine}" BorderThickness="0,0,0,1" Padding="10,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Appearance="Secondary" Padding="10,4" Click="AnalysisBack_Click"
                                       ToolTip="返回跟打">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="返回" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                            <TextBlock x:Name="AnalysisTitle" Text="" Margin="14,0,0,0"
                                       FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ValueFG}"/>
                        </StackPanel>
                    </Border>
                    <ContentControl x:Name="AnalysisContent"/>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
    </Grid>
</ui:FluentWindow>
