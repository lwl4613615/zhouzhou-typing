<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>newgdq</RootNamespace>
    <AssemblyName>newgdq</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- 保留手写 AssemblyInfo.cs（含 ThemeInfo / 版本号），关掉自动生成避免重复特性 -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <!-- WFO0003：WinForms 分析器建议把 DPI 从 manifest 挪走。本应用是 WPF 主导、仅互操作
         引用 WinForms（Screen/SystemSounds），app.manifest 的 PerMonitorV2 是 WPF 的 DPI
         权威配置必须保留，故针对性消除此框架间误报（非掩盖真实兼容问题）。 -->
    <NoWarn>WFO0003</NoWarn>
    <ApplicationIcon>Resources\myicon.ico</ApplicationIcon>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>
  
  <!-- 把资源 txt/ico/jpg 标成 WPF Resource（默认会被当 None，先剔除再加） -->
  <ItemGroup>
    <None Remove="Resources\**\*.txt" />
    <None Remove="Resources\**\*.ico" />
    <None Remove="Resources\**\*.jpg" />
    <Resource Include="Resources\bm.txt" />
    <Resource Include="Resources\myicon.ico" />
    <Resource Include="Resources\erweima.jpg" />
    <Resource Include="Resources\TXT\**\*.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HandyControl" Version="3.5.1" />
    <PackageReference Include="OxyPlot.Wpf" Version="2.2.0" />
    <PackageReference Include="ScottPlot.WPF" Version="5.1.58" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.118.0" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
  </ItemGroup>

</Project>
